// The checker (S3): the walk over a loaded program.
//
// `./scripts/selfhost.sh check` compares the codes this pass reports with the code
// each program is expected to fail with, so a family lands when that count moves.
//
// A name is in scope when it is a builtin, a runtime function, a prelude class, a
// module alias, a top-level declaration, or bound in an enclosing block by a
// parameter, an assignment target, a `for` variable, a `catch` variable, a match
// arm's payload or a closure parameter. Scopes are pushed per block, so a name
// declared in a block is gone when the block ends, and a name used before its
// declaration is unknown — the oracle's rule.
//
// The pieces are elsewhere on purpose: `names.kode` collects every declared name and
// reports a declaration that cannot stand, `scope.kode` is the frame stack,
// `typing.kode` says what a value is, `annotations.kode` what a written type means,
// `items.kode` what a declaration puts in scope, `operands.kode` which operands an
// operator and `print` accept, `assign.kode` what an assignment does, and
// `namespace.kode` the rules of a module alias. The namespace is program-wide, not
// per file: every file's names are collected before any of them is walked.

from "./annotations" import resolve_ann
from "./ast" import Ast, is_type_node
from "./binding" import bound_local
from "./builtins" import Builtins
from "./diag" import Diag, diag, diag_help
from "./functions" import check_call, check_expr_body, check_paths, check_return
from "./items" import pop_type_params, setup_class, setup_fn
from "./modules" import Alias, Module
from "./names" import Names, collect
from "./namespace" import alias_diags, check_alias
from "./operands" import check_operator, check_print
from "./patterns" import bind_arm_names
from "./scope" import Scope
from "./signatures" import SigTable, Signature, collect_signatures
from "./typing" import type_any

pub class Sema {
    /// Every file the program loads, the entry first, from `modules.kode`.
    asts: [Ast] = []
    /// The file being walked; `asts` drives it, so the visitors stay one-file code.
    ast: Ast = Ast()
    /// The loaded modules, for what a module alias may reach (`E0411`).
    mods: [Module] = []
    /// Every `import "..." as n` in the program, in load order (`E0408`/`E0409`).
    aliases: [Alias] = []
    diags: [Diag] = []
    /// Every declaration in the program: what a name resolves against, and what an
    /// annotation may name.
    names: Names = Names()
    /// Bound names and what they hold, innermost frame last.
    scopes: Scope = Scope()
    /// The names a program starts with, in their own file (`builtins.kode`).
    builtins: Builtins = Builtins()
    /// Every function's and class's parameters and result (`signatures.kode`).
    sigs: SigTable = SigTable()
    /// The signature of the function being walked, which `return` reads; a name of
    /// "" means no function (a method, or the top level).
    current: Signature = Signature(name: "")
    /// `return` needs a function (`E0311`) and `break`/`continue` a loop (`E0314`).
    in_fn: bool = false
    loops: int = 0

    /// Check a loaded program; the caller prints `diags`.
    fn run() {
        for one in asts {
            ast = one
            collect(ast, names, builtins, diags)
        }
        // Calls are checked against a program-wide table, so it is built before any
        // file is walked (`signatures.kode`).
        collect_signatures(asts, names, sigs)
        // An alias is a program-wide name, so its rules run once every file's
        // declarations exist (`namespace.kode`).
        for d in alias_diags(aliases, names.decls) {
            diags.add(d)
        }
        scopes.push()
        for one in asts {
            ast = one
            walk_program()
        }
        scopes.pop()
    }

    fn walk_program() {
        for id in ast.nodes[0].kids {
            if is_item(ast.nodes[id].kind) {
                check_item(id)
            } else {
                visit(id)
            }
        }
    }

    fn check_item(id: int) {
        kind = ast.nodes[id].kind
        if kind == "Fn" {
            check_fn(id, false)
        } else if kind == "Class" {
            check_class(id)
        } else if kind == "Const" {
            for kid in ast.nodes[id].kids {
                if is_type_node(ast.nodes[kid].kind) {
                    resolve_ann(ast, names, diags, kid)
                } else {
                    visit(kid)
                }
            }
        }
    }

    /// `is_method`: a method's signature is not in the table yet (its receiver's
    /// class is not resolved here), so a method is walked without argument and
    /// return rules rather than against the free function that shares its name.
    fn check_fn(id: int, is_method: bool) {
        scopes.push()
        before = setup_fn(ast, names, scopes, diags, id)
        was = in_fn
        in_fn = true
        sig = Signature(name: "")
        if not is_method {
            sig = sigs.find(ast.attr_text(id, "name"))
        }
        previous = current
        current = sig
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "Block" {
                visit(kid)
                check_paths(ast, diags, id, kid, sig)
            } else if kind == "ExprBody" {
                visit(kid)
                check_expr_body(ast, scopes.frames, names, diags, id, kid, sig)
            }
        }
        current = previous
        in_fn = was
        scopes.pop()
        pop_type_params(names, before)
    }

    /// A method reads its class's fields and methods by bare name, so they are in
    /// scope for the whole class.
    fn check_class(id: int) {
        scopes.push()
        before = setup_class(ast, names, scopes, diags, id)
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "Method" {
                check_fn(kid, true)
            }
            if kind == "Field" {
                for part in ast.nodes[kid].kids {
                    if not is_type_node(ast.nodes[part].kind) {
                        visit(part)
                    }
                }
            }
        }
        scopes.pop()
        pop_type_params(names, before)
    }

    fn is_bound(name: string) -> bool {
        if names.all.contains(name) or builtins.has(name) {
            return true
        }
        return scopes.find(name).name != ""
    }

    /// One node. The kinds that bind or resolve names have their own function;
    /// everything else is walked through, and a type annotation is skipped. The two
    /// operator nodes are checked here and still walked, because their operands are
    /// expressions like any other.
    fn visit(id: int) {
        kind = ast.nodes[id].kind
        if kind == "Ident" {
            visit_ident(id)
            return
        }
        if kind == "Assign" {
            visit_assign(id)
            return
        }
        if kind == "Call" {
            visit_call(id)
            return
        }
        if kind == "MethodCall" {
            visit_method(id)
            return
        }
        if kind == "Catch" {
            visit_catch(id)
            return
        }
        if kind == "Closure" {
            visit_closure(id)
            return
        }
        if kind == "For" {
            visit_for(id)
            return
        }
        if kind == "ForIn" {
            visit_for_in(id)
            return
        }
        if kind == "While" {
            visit_while(id)
            return
        }
        if kind == "Try" {
            visit_try(id)
            return
        }
        if kind == "Match" {
            visit_match(id)
            return
        }
        if kind == "Block" {
            visit_block(id)
            return
        }
        if kind == "Return" {
            visit_return(id)
            return
        }
        if kind == "Break" or kind == "Continue" {
            visit_loop_keyword(id)
            return
        }
        if kind == "TargetVar" {
            scopes.declare(ast.attr_text(id, "name"), type_any())
            return
        }
        if kind == "Var" or kind == "CatchVar" {
            return
        }
        if is_type_node(kind) {
            return
        }
        if kind == "Binary" or kind == "Unary" {
            check_operator(ast, scopes.frames, names, diags, id)
        }
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
    }

    fn visit_block(id: int) {
        scopes.push()
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
        scopes.pop()
    }

    fn visit_ident(id: int) {
        name = ast.attr_text(id, "name")
        if name != "" and not is_bound(name) {
            diag(ast, diags, "E0201", "unknown variable `${name}`", id)
        }
    }

    /// `x = 1` binds `x` to the value's type (`assign.kode`); `xs[0] = 1` and
    /// `obj.name = 1` are reads of what they index into. The value is always walked.
    fn visit_assign(id: int) {
        kids = ast.nodes[id].kids
        if kids.len() == 0 {
            return
        }
        target = kids[0]
        if ast.nodes[target].kind == "TargetVar" {
            // A call the checker refuses declares nothing, so the next line's use of
            // the name is unknown — the oracle's rule (and what makes
            // `e0208_generic_mismatch` report `E0201`).
            if not value_fails(kids) {
                one = bound_local(ast, scopes.frames, names, diags, id, target)
                if one.name != "" {
                    scopes.declare(one.name, one.ty)
                }
            }
        } else {
            visit(target)
        }
        i = 1
        while i < kids.len() {
            if not is_type_node(ast.nodes[kids[i]].kind) {
                visit(kids[i])
            }
            i += 1
        }
    }

    /// Would the assignment's value be a call the checker refuses? Asked before the
    /// name is declared, with a scratch list so the call is reported once, later, by
    /// `visit_call`.
    fn value_fails(kids: [int]) -> bool {
        if kids.len() < 2 {
            return false
        }
        value = kids[kids.len() - 1]
        if ast.nodes[value].kind != "Call" {
            return false
        }
        scratch: [Diag] = []
        check_call(ast, scopes.frames, names, sigs, scratch, value)
        return scratch.len() > 0
    }

    fn visit_call(id: int) {
        callee = ast.attr_text(id, "callee")
        if callee != "" and not is_bound(callee) {
            diag(ast, diags, "E0206", "unknown function `${callee}`", id)
        }
        if callee == "print" or callee == "stderr" {
            check_print(ast, scopes.frames, names, diags, id)
        } else {
            check_call(ast, scopes.frames, names, sigs, diags, id)
        }
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
    }

    /// `mods.f(...)`: the module alias rules are `namespace.kode`'s.
    fn visit_method(id: int) {
        callee = ast.attr_text(id, "name")
        kids = ast.nodes[id].kids
        if kids.len() > 0 and ast.nodes[kids[0]].kind == "Ident" {
            base = ast.attr_text(kids[0], "name")
            check_alias(ast, mods, aliases, names.decls, diags, id, base, callee)
        }
        for kid in kids {
            visit(kid)
        }
    }

    /// `expr catch err { }`: the variable is an attribute and is in scope in the
    /// block, like the statement form's `CatchVar`.
    fn visit_catch(id: int) {
        scopes.push()
        scopes.declare(ast.attr_text(id, "var"), type_any())
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
        scopes.pop()
    }

    fn visit_closure(id: int) {
        scopes.push()
        body: [int] = []
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "ClosureParam" {
                scopes.declare(ast.attr_text(kid, "name"), type_any())
            } else {
                body.add(kid)
            }
        }
        for kid in body {
            visit(kid)
        }
        scopes.pop()
    }

    /// `for i in 0..3`: the variable is an attribute.
    fn visit_for(id: int) {
        scopes.push()
        scopes.declare(ast.attr_text(id, "var"), type_any())
        loops += 1
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
        loops -= 1
        scopes.pop()
    }

    /// `for i, v in xs`: the variables are `Var` children, the body a block.
    fn visit_for_in(id: int) {
        scopes.push()
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "Var" {
                scopes.declare(ast.attr_text(kid, "name"), type_any())
            }
        }
        loops += 1
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "Iter" or kind == "Block" {
                visit(kid)
            }
        }
        loops -= 1
        scopes.pop()
    }

    /// `while cond { }`: a loop, so `break` and `continue` work inside it.
    fn visit_while(id: int) {
        loops += 1
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
        loops -= 1
    }

    fn visit_return(id: int) {
        if not in_fn {
            diag_help(ast, diags, "E0311", "`return` can only be used inside a function", id,
                "top-level code simply runs to the end")
        }
        check_return(ast, scopes.frames, names, diags, id, current)
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
    }

    fn visit_loop_keyword(id: int) {
        if loops > 0 {
            return
        }
        word = "break"
        if ast.nodes[id].kind == "Continue" {
            word = "continue"
        }
        diag(ast, diags, "E0314", "`${word}` can only be used inside a loop", id)
    }

    /// `try { } catch err { } finally { }`: `err` is in scope in the handler only.
    fn visit_try(id: int) {
        opened = false
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "CatchVar" {
                scopes.push()
                opened = true
                scopes.declare(ast.attr_text(kid, "name"), type_any())
            } else if kind == "Handler" {
                visit(kid)
                if opened {
                    scopes.pop()
                    opened = false
                }
            } else {
                visit(kid)
            }
        }
        if opened {
            scopes.pop()
        }
    }

    fn visit_match(id: int) {
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "Arm" {
                visit_arm(kid)
            } else {
                visit(kid)
            }
        }
    }

    fn visit_arm(id: int) {
        scopes.push()
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "PatternValue" {
                bind_arm_names(ast, scopes, kid)
            } else {
                visit(kid)
            }
        }
        scopes.pop()
    }

}

/// The node kinds that declare a name for the whole program.
fn is_item(kind: string) -> bool {
    if kind == "Fn" or kind == "Class" or kind == "Enum" or kind == "Interface" {
        return true
    }
    return kind == "Const" or kind == "Import"
}
