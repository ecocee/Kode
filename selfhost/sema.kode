// The checker (S3): name resolution, the import namespace, and the types a value
// holds.
//
// `./scripts/selfhost.sh check` runs this pass over `tests/compile-fail` and
// `tests/run-pass` and compares the codes it reports with the code each program is
// expected to fail with, so a family lands when that count moves. The oracle's
// `E02xx` family arrives one slice per commit (docs/PLAN-self-hosting.md §4).
//
// A name is in scope when it is a builtin, a runtime function, a prelude class, a
// module alias, a top-level declaration, or bound in an enclosing block by a
// parameter, an assignment target, a `for` variable, a `catch` variable, a match
// arm's payload or a closure parameter. Scopes are pushed per block, so a name
// declared in a block is gone when the block ends, and a name used before its
// declaration is unknown — the oracle's rule. `selfhost/scope.kode` holds the stack,
// `selfhost/typing.kode` what its entries hold, and `selfhost/namespace.kode` the
// rules of a module alias.
//
// The namespace is program-wide, not per file: `selfhost/modules.kode` reads
// everything the program imports, and every file's top-level names are collected
// before any of them is walked, so `stmt.kode` resolves `BP_ARITH` from
// `infix.kode` without importing it.

from "./ast" import Ast
from "./builtins" import Builtins
from "./diag" import Diag, diag, diag_help
from "./modules" import Alias, Module
from "./namespace" import alias_diags, check_alias
from "./operands" import check_operator, check_print
from "./scope" import Scope
from "./typing" import Anns, Type, coerce_value, expr_type, resolve_ann, type_any

pub class Sema {
    /// Every file the program loads, the entry first, from `modules.kode`.
    asts: [Ast] = []
    /// The file being walked; `asts` drives it, so the visitors stay one-file code.
    ast: Ast = Ast()
    /// The loaded modules, for what a module alias may reach (`E0411`).
    mods: [Module] = []
    /// Every `import "..." as n` in the program, in load order (`E0408`/`E0409`).
    aliases: [Alias] = []
    diags: [Diag] = []
    /// Every top-level name: `fn`, `class`, `enum`, `interface`, `const`, `import`.
    globals: [string] = []
    /// The declarations alone: what a module alias may not hide (`E0409`).
    decls: [string] = []
    /// The class names: `User(name: "a")` builds an instance of one.
    classes: [string] = []
    /// What an annotation may name, and the type parameters in scope: the lists
    /// `resolve_ann` reads, in the file that reads them.
    anns: Anns = Anns()
    /// Bound names and what they hold, innermost frame last.
    scopes: Scope = Scope()
    /// The names a program starts with, in their own file (`builtins.kode`).
    builtins: Builtins = Builtins()

    /// Check a loaded program; the caller prints `diags`. Every top-level name of
    /// every file is collected first, because the namespace is program-wide and a
    /// function may be called before the line that declares it, and every declared
    /// type, because an annotation may name one from another file. Top-level
    /// statements then run in one shared scope.
    fn run() {
        for one in asts {
            ast = one
            collect_globals()
        }
        // An alias is a program-wide name, so its rules run once every file's
        // declarations exist (`namespace.kode`).
        for diag in alias_diags(aliases, decls) {
            diags.add(diag)
        }
        scopes.push()
        for one in asts {
            ast = one
            walk_program()
        }
        scopes.pop()
    }

    fn walk_program() {
        for id in ast.nodes[0].kids {
            if is_item(ast.nodes[id].kind) {
                check_item(id)
            } else {
                visit(id)
            }
        }
    }

    fn collect_globals() {
        for id in ast.nodes[0].kids {
            kind = ast.nodes[id].kind
            if kind == "Fn" or kind == "Class" or kind == "Enum" or kind == "Interface" or kind == "Const" {
                globals.add(ast.attr_text(id, "name"))
                decls.add(ast.attr_text(id, "name"))
            }
            if kind == "Class" {
                classes.add(ast.attr_text(id, "name"))
                if has_type_param(id) {
                    // A bare generic name is `E0423`, so its annotation is not a
                    // type this slice can use.
                    anns.generics.add(ast.attr_text(id, "name"))
                }
            }
            if kind == "Class" or kind == "Enum" or kind == "Interface" {
                anns.types.add(ast.attr_text(id, "name"))
            }
            if kind == "Import" {
                for kid in ast.nodes[id].kids {
                    globals.add(ast.attr_text(kid, "name"))
                }
            }
        }
    }

    fn check_item(id: int) {
        kind = ast.nodes[id].kind
        if kind == "Fn" {
            check_fn(id)
        } else if kind == "Class" {
            check_class(id)
        } else if kind == "Const" {
            for kid in ast.nodes[id].kids {
                if is_type(ast.nodes[kid].kind) {
                    resolve_ann(ast, anns, diags, kid)
                } else {
                    visit(kid)
                }
            }
        }
    }

    /// Does this item declare type parameters (`class Box<T>`)?
    fn has_type_param(id: int) -> bool {
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "TypeParam" {
                return true
            }
        }
        return false
    }

    fn check_fn(id: int) {
        before = push_type_params(id)
        scopes.push()
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "Param" {
                declare_param(kid)
            } else if is_type(kind) {
                // The return type, so that an unknown name is `E0303` here too.
                resolve_ann(ast, anns, diags, kid)
            }
        }
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "Block" or kind == "ExprBody" {
                visit(kid)
            }
        }
        scopes.pop()
        pop_type_params(before)
    }

    /// `a: int` binds `a` to `int`; an annotation this slice cannot name is `any`, so
    /// nothing is claimed about the uses.
    fn declare_param(id: int) {
        ty = annotation_of(id)
        scopes.declare(ast.attr_text(id, "name"), ty)
    }

    /// The type a `Param` or `Field` is annotated with, resolving it (and so
    /// reporting `E0303`); `any` when it has none.
    fn annotation_of(id: int) -> Type {
        for kid in ast.nodes[id].kids {
            if is_type(ast.nodes[kid].kind) {
                return resolve_ann(ast, anns, diags, kid)
            }
        }
        return type_any()
    }

    /// A method reads its class's fields and methods by bare name, so they are in
    /// scope for the whole class.
    fn check_class(id: int) {
        before = push_type_params(id)
        scopes.push()
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "Field" {
                scopes.declare(ast.attr_text(kid, "name"), annotation_of(kid))
            }
            if kind == "Method" {
                scopes.declare(ast.attr_text(kid, "name"), type_any())
            }
        }
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "Method" {
                check_fn(kid)
            }
            if kind == "Field" {
                for part in ast.nodes[kid].kids {
                    if not is_type(ast.nodes[part].kind) {
                        visit(part)
                    }
                }
            }
        }
        scopes.pop()
        pop_type_params(before)
    }

    /// The type parameters an item declares, made visible to its annotations.
    fn push_type_params(id: int) -> int {
        before = anns.params.len()
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "TypeParam" {
                anns.params.add(ast.attr_text(kid, "name"))
            }
        }
        return before
    }

    fn pop_type_params(before: int) {
        while anns.params.len() > before {
            anns.params.pop()
        }
    }

    fn is_bound(name: string) -> bool {
        if globals.contains(name) or builtins.has(name) {
            return true
        }
        return scopes.find(name).name != ""
    }

    /// One node. The kinds that bind or resolve names have their own function;
    /// everything else is walked through, and a type annotation is skipped. The two
    /// operator nodes are checked here and still walked, because their operands are
    /// expressions like any other.
    fn visit(id: int) {
        kind = ast.nodes[id].kind
        if kind == "Ident" {
            visit_ident(id)
            return
        }
        if kind == "Assign" {
            visit_assign(id)
            return
        }
        if kind == "Call" {
            visit_call(id)
            return
        }
        if kind == "MethodCall" {
            visit_method(id)
            return
        }
        if kind == "Catch" {
            visit_catch(id)
            return
        }
        if kind == "Closure" {
            visit_closure(id)
            return
        }
        if kind == "For" {
            visit_for(id)
            return
        }
        if kind == "ForIn" {
            visit_for_in(id)
            return
        }
        if kind == "Try" {
            visit_try(id)
            return
        }
        if kind == "Match" {
            visit_match(id)
            return
        }
        if kind == "Block" {
            visit_block(id)
            return
        }
        if kind == "TargetVar" {
            scopes.declare(ast.attr_text(id, "name"), type_any())
            return
        }
        if kind == "Var" or kind == "CatchVar" {
            return
        }
        if is_type(kind) {
            return
        }
        if kind == "Binary" or kind == "Unary" {
            check_operator(ast, scopes.frames, classes, diags, id)
        }
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
    }

    fn visit_block(id: int) {
        scopes.push()
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
        scopes.pop()
    }

    fn visit_ident(id: int) {
        name = ast.attr_text(id, "name")
        if name != "" and not is_bound(name) {
            diag(ast, diags, "E0201", "unknown variable `${name}`", id)
        }
    }

    /// `x = 1` binds `x` to what the value is; `x = "a"` after `x = 1` is `E0202`, as
    /// is a value that does not fit `x`'s annotation. `xs[0] = 1` and `obj.name = 1`
    /// are reads of what they index into. The value is always walked.
    fn visit_assign(id: int) {
        kids = ast.nodes[id].kids
        if kids.len() == 0 {
            return
        }
        target = kids[0]
        ann = -1
        value = -1
        i = kids.len() - 1
        while i >= 1 {
            if is_type(ast.nodes[kids[i]].kind) {
                ann = kids[i]
            } else if value < 0 {
                value = kids[i]
            }
            i -= 1
        }
        vt = type_any()
        if value >= 0 {
            vt = expr_type(ast, scopes.frames, classes, value)
        }
        if ast.nodes[target].kind == "TargetVar" {
            bind(ast.attr_text(target, "name"), ann, value, vt)
        } else {
            visit(target)
        }
        i = 1
        while i < kids.len() {
            if not is_type(ast.nodes[kids[i]].kind) {
                visit(kids[i])
            }
            i += 1
        }
    }

    /// One `name = value`, with or without an annotation. An annotated target takes
    /// the annotation's type; an unannotated one keeps the type it already had, which
    /// is what makes a later value of another type `E0202`.
    fn bind(name: string, ann: int, value: int, vt: Type) {
        if ann >= 0 {
            want = resolve_ann(ast, anns, diags, ann)
            if value >= 0 {
                coerce_value(ast, diags, value, vt, want, name)
            }
            scopes.declare(name, want)
            return
        }
        have = scopes.find(name)
        if have.name != "" {
            if value >= 0 {
                coerce_value(ast, diags, value, vt, have.ty, name)
            }
            return
        }
        scopes.declare(name, vt)
    }

    fn visit_call(id: int) {
        callee = ast.attr_text(id, "callee")
        if callee != "" and not is_bound(callee) {
            diag(ast, diags, "E0206", "unknown function `${callee}`", id)
        }
        if callee == "print" or callee == "stderr" {
            check_print(ast, scopes.frames, classes, diags, id)
        }
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
    }

    /// `mods.f(...)`: the module alias rules are `namespace.kode`'s.
    fn visit_method(id: int) {
        callee = ast.attr_text(id, "name")
        kids = ast.nodes[id].kids
        if kids.len() > 0 and ast.nodes[kids[0]].kind == "Ident" {
            base = ast.attr_text(kids[0], "name")
            check_alias(ast, mods, aliases, decls, diags, id, base, callee)
        }
        for kid in kids {
            visit(kid)
        }
    }

    /// `expr catch err { }`: the variable is an attribute and is in scope in the
    /// block, like the statement form's `CatchVar`.
    fn visit_catch(id: int) {
        scopes.push()
        scopes.declare(ast.attr_text(id, "var"), type_any())
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
        scopes.pop()
    }

    fn visit_closure(id: int) {
        scopes.push()
        body: [int] = []
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "ClosureParam" {
                scopes.declare(ast.attr_text(kid, "name"), type_any())
            } else {
                body.add(kid)
            }
        }
        for kid in body {
            visit(kid)
        }
        scopes.pop()
    }

    /// `for i in 0..3`: the variable is an attribute and counts, so it is an int.
    fn visit_for(id: int) {
        scopes.push()
        scopes.declare(ast.attr_text(id, "var"), type_any())
        for kid in ast.nodes[id].kids {
            visit(kid)
        }
        scopes.pop()
    }

    /// `for i, v in xs`: the variables are `Var` children, the body a block.
    fn visit_for_in(id: int) {
        scopes.push()
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "Var" {
                scopes.declare(ast.attr_text(kid, "name"), type_any())
            }
        }
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "Iter" or kind == "Block" {
                visit(kid)
            }
        }
        scopes.pop()
    }

    /// `try { } catch err { } finally { }`: `err` is in scope in the handler only.
    fn visit_try(id: int) {
        opened = false
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "CatchVar" {
                scopes.push()
                opened = true
                scopes.declare(ast.attr_text(kid, "name"), type_any())
            } else if kind == "Handler" {
                visit(kid)
                if opened {
                    scopes.pop()
                    opened = false
                }
            } else {
                visit(kid)
            }
        }
        if opened {
            scopes.pop()
        }
    }

    fn visit_match(id: int) {
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "Arm" {
                visit_arm(kid)
            } else {
                visit(kid)
            }
        }
    }

    fn visit_arm(id: int) {
        scopes.push()
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            if kind == "PatternValue" {
                bind_pattern(kid)
            } else {
                visit(kid)
            }
        }
        scopes.pop()
    }

    /// The names an arm pattern binds: the arguments of `Shape.Circle(r)` are
    /// bindings, while the `Shape` before the dot is a reference.
    fn bind_pattern(id: int) {
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind != "MethodCall" {
                continue
            }
            for arg in ast.nodes[kid].kids {
                if ast.nodes[arg].kind != "Arg" {
                    continue
                }
                for inner in ast.nodes[arg].kids {
                    if ast.nodes[inner].kind == "Ident" {
                        scopes.declare(ast.attr_text(inner, "name"), type_any())
                    }
                }
            }
        }
    }
}

/// `TypeName`, `TypeList`, `TypeFn` and the rest: an annotation names types, not
/// values, so the walker never enters one.
fn is_type(kind: string) -> bool {
    if kind.size() < 4 {
        return false
    }
    return kind.slice(0, 4) == "Type"
}

/// The node kinds that declare a name for the whole program.
fn is_item(kind: string) -> bool {
    if kind == "Fn" or kind == "Class" or kind == "Enum" or kind == "Interface" {
        return true
    }
    return kind == "Const" or kind == "Import"
}
