// The walk that builds the MIR an interpreter runs (S4).
//
// Slice 1 lowered `print` of scalar literals. Slice 2 adds a local — `x = <int
// expression>` — and `+`, so the function now has temporaries, and the oracle's
// rules for them are exact:
//
//   * every variable and every intermediate `+` gets one temporary, numbered in the
//     order the program is walked; printing a string, bool or float literal directly
//     gets none;
//   * the `let` lines come before `bb0:`, with the variable's own name as a comment
//     (`    let _0: int  // x`) and none for an intermediate (`    let _1: int`);
//   * `bb0` opens with one `_N = 0` per temporary, in index order, then the code;
//   * `a + b` lowers `a`, then `b`, then emits `_N = add a, b`, where an operand
//     prints as itself (`1`) or as its temporary (`_0`).
//
// Slice 4 makes a string a reference (`ref`), which is what the retain/release lines
// are about:
//
//   * a string temporary is `    let _0: ref` and is zeroed to `_0 = null`;
//   * storing into a string variable releases the old value first, always, including
//     the first store over the null (`release _0`, then `_0 = "a"`);
//   * an intermediate reference is released at its last use (`call rt::PrintStr(_1)`
//     then `release _1`), while a variable is released once in `bb1`, in index order;
//   * `x + y` on strings is `_N = call rt::StrConcat(x, y)`; a literal argument is
//     borrowed, and a result stored into a variable is moved, not released.
//
// Slice 5 adds interpolation as a `print` argument: the pieces are its non-empty
// literals and holes, the head becomes the accumulator (a literal head is released
// after its first concat, a variable head is retained first), each following piece is
// a `StrConcat` whose old accumulator is released and whose int hole — an owned
// `IntToStr` temporary — is released too, and a lone hole is only a `retain`.
//
// Slice 6 adds comparisons and `if`, the first shapes with more than one block: the
// entry is `bb0`, the exit (releases and `return`) is `bb1`, and the blocks the walk
// creates follow in creation order — an `if` makes its then-block, its join, and then
// its else-block when there is one, each ending in `goto <join>`, with
// `branch _1, <then>, <else>` at the split.
//
// Slice 7 adds `while`, `break` and `continue`: a loop creates its condition block, its
// body block and its exit block in that order, the code before it ends with
// `goto <cond>`, `continue` jumps to the condition and `break` to the exit. A block
// that already ends in a terminator is never written again — the next instruction goes
// into a fresh block — which is why an arm ending in `continue` leaves an extra block
// that only `goto`s its join.
//
// A statement outside those shapes sets `ok = false` with a reason, and `main.kode`
// says so and exits 2 rather than printing a MIR that would not run.

from "./ast" import Ast
from "./literals" import parse_int
from "./mir" import Block, Function, Instr, Mir, Operand, Piece, Temp, Value, is_param

pub class Builder {
    ast: Ast
    main: Function
    /// The entry block (`bb0`), kept so the assembly can put the zero inits first.
    entry: Block
    block: Block
    /// The exit block (`bb1`), where the walk's last block jumps.
    end: Block
    /// The slot kind the function returns, and the temporary that holds it once a
    /// `return` has been walked (allocated lazily, at the first one: the oracle's
    /// numbering puts it after everything the return expression needed).
    ret_kind: string = "unit"
    ret_temp: int = -1
    /// Whether the body is a `{ ... }` block (which ends in `unreachable` when the
    /// function returns something) rather than `=> expr` sugar (which does not).
    block_body: bool = false
    /// The blocks the walk created, in creation order; the dump keeps that order.
    blocks: [Block] = []
    next_label: int = 2
    /// Where `break` and `continue` go, innermost loop last.
    break_to: [string] = []
    continue_to: [string] = []
    names: [string] = []
    slots: [int] = []
    ok: bool = true
    why: string = ""
    /// Whether to record every unsupported construct and keep walking, instead of
    /// stopping at the first one (`kode-stage1 report`).
    collecting: bool = false
    /// What the walk could not lower, once each, in the order it met them.
    problems: [string] = []
    /// Names whose declaration was refused. Reading one is a consequence of that
    /// refusal, so it is not reported again (and the ledger does not churn when a
    /// variable is renamed).
    unknown_names: [string] = []

    /// Whether the current block already ends in a terminator.
    fn terminated() -> bool {
        if block.instrs.len() == 0 {
            return false
        }
        last = block.instrs[block.instrs.len() - 1].kind
        return last == "goto" or last == "branch" or last == "return"
    }

    /// Append an instruction, starting a fresh block first if the current one is ended.
    fn emit(one: Instr) {
        if terminated() {
            switch_to(new_block())
        }
        block.instrs.add(one)
    }

    /// A fresh block, labelled in creation order after the entry and the exit.
    fn new_block() -> Block {
        b = Block(label: "bb${next_label}")
        next_label += 1
        blocks.add(b)
        return b
    }

    fn switch_to(b: Block) {
        block = b
    }

    /// A new temporary, of the given kind, optionally the variable it belongs to.
    fn temp(name: string, kind: string) -> int {
        index = main.temps.len()
        main.temps.add(Temp(kind: kind, name: name))
        return index
    }

    /// Whether an operand is a borrowed reference: a named temporary (a parameter or a
    /// local). The slot or return position that takes it must retain it first; an
    /// intermediate is moved, and a literal is static.
    fn borrowed(o: Operand) -> bool {
        if not o.is_temp {
            return false
        }
        return main.temps[o.index].kind == "ref" and main.temps[o.index].name != ""
    }

    /// Whether a name is in a list of names: `slot`'s linear scan, for strings.
    fn has_name(pool: [string], name: string) -> bool {
        for one in pool {
            if one == name {
                return true
            }
        }
        return false
    }

    fn slot(name: string) -> int {
        for k in 0..names.len() {
            if names[k] == name {
                return slots[k]
            }
        }
        return -1
    }

    /// The type of an operand's value: the temporary's, or the literal's kind. A
    /// reference temporary holds a string, so it reads as `str` here, while its slot
    /// stays declared `ref`.
    fn kind_of(o: Operand) -> string {
        if o.is_temp {
            if main.temps[o.index].kind == "ref" {
                return "str"
            }
            return main.temps[o.index].kind
        }
        return o.value.kind
    }

    /// The runtime call that prints a value of that kind.
    fn print_primitive(o: Operand) -> string {
        kind = kind_of(o)
        if kind == "int" {
            return "rt::PrintInt"
        }
        if kind == "float" {
            return "rt::PrintFloat"
        }
        if kind == "bool" {
            return "rt::PrintBool"
        }
        return "rt::PrintStr"
    }

    fn stop(reason: string) {
        // Collecting: remember it once and let the walk continue, so a program that
        // needs five things reports five rather than one. Otherwise the first refusal
        // ends the walk, which is what `mir` and `run` still do.
        if collecting {
            for seen in problems {
                if seen == reason {
                    return
                }
            }
            problems.add(reason)
            return
        }
        if ok {
            ok = false
            why = reason
        }
    }

    fn stmt(id: int) {
        if not ok {
            return
        }
        kind = ast.nodes[id].kind
        if kind == "ExprStmt" {
            for kid in ast.nodes[id].kids {
                if ast.nodes[kid].kind != "Call" or ast.attr_text(kid, "callee") != "print" {
                    stop("a call other than `print`")
                    return
                }
                print_call(kid)
            }
            return
        }
        if kind == "Assign" {
            assign(id)
            return
        }
        if kind == "Block" {
            // A block is its statements, in place.
            for kid in ast.nodes[id].kids {
                stmt(kid)
            }
            return
        }
        if kind == "If" {
            if_stmt(id)
            return
        }
        if kind == "While" {
            while_stmt(id)
            return
        }
        if kind == "Return" {
            ret_stmt(id)
            return
        }
        if kind == "Break" {
            if break_to.len() == 0 {
                stop("a `break` outside a loop")
                return
            }
            emit(Instr(kind: "goto", target: break_to[break_to.len() - 1]))
            return
        }
        if kind == "Continue" {
            if continue_to.len() == 0 {
                stop("a `continue` outside a loop")
                return
            }
            emit(Instr(kind: "goto", target: continue_to[continue_to.len() - 1]))
            return
        }
        stop("statement `${kind}`")
    }

    fn assign(id: int) {
        var_name = ""
        var_id = -1
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "TargetVar" {
                var_id = kid
                var_name = ast.attr_text(kid, "name")
            }
        }
        if var_id < 0 {
            stop("an assignment to something other than a name")
            return
        }
        value = ast.nodes[id].kids[ast.nodes[id].kids.len() - 1]
        if value == var_id {
            stop("an assignment with no value")
            return
        }
        // The oracle lowers the value first, so its temporaries come before the
        // variable's: `x = 1 + 2` is `_0 = add 1, 2` then `_1 = _0`.
        operand = expr(value)
        if not ok {
            return
        }
        kind = kind_of(operand)
        // A refused value is already reported; its kind is not a second finding. The
        // name still counts as declared, so reads of it are not either.
        if kind == "?" {
            unknown_names.add(var_name)
            return
        }
        if kind != "int" and kind != "str" {
            stop("`${var_name}` holding a `${kind}`")
            return
        }
        slot_kind = temp_kind(kind)
        index = slot(var_name)
        if index < 0 {
            index = temp(var_name, slot_kind)
            names.add(var_name)
            slots.add(index)
        } else if main.temps[index].kind != slot_kind {
            stop("`${var_name}` changing from `${main.temps[index].kind}` to `${slot_kind}`")
            return
        }
        // A reference slot releases what it held before it is overwritten — for the
        // first store too, where the oracle releases the null it was zeroed with.
        if slot_kind == "ref" {
            // A slot outlives the variable it is handed, so a borrowed reference is
            // retained before the slot lets go of what it held.
            if borrowed(operand) {
                emit(Instr(kind: "retain", args: [operand]))
            }
            emit(Instr(kind: "release", args: [Operand(is_temp: true, index: index)]))
        }
        emit(Instr(kind: "assign", dest: index, args: [operand]))
    }

    /// `return`: the value first, then the return slot, then the jump to `bb1`.
    fn ret_stmt(id: int) {
        if ast.nodes[id].kids.len() == 0 {
            if ret_kind != "unit" {
                stop("a `return` with no value in a function that returns one")
                return
            }
            emit(Instr(kind: "goto", target: "bb1"))
            return
        }
        operand = expr(ast.nodes[id].kids[0])
        if not ok {
            return
        }
        ret_operand(operand)
    }

    /// `fn f() -> T => expr`: the sugar is the same walk as `return expr`.
    fn ret_expr(body: int) {
        if ast.nodes[body].kids.len() == 0 {
            stop("a `=>` body with no expression")
            return
        }
        operand = expr(ast.nodes[body].kids[0])
        if not ok {
            return
        }
        ret_operand(operand)
    }

    fn ret_operand(o: Operand) {
        if kind_of(o) == "?" {
            return
        }
        if ret_temp < 0 {
            ret_temp = temp("", ret_kind)
        }
        if ret_kind == "ref" and borrowed(o) {
            emit(Instr(kind: "retain", args: [o]))
        }
        emit(Instr(kind: "assign", dest: ret_temp, args: [o]))
        emit(Instr(kind: "goto", target: "bb1"))
    }

    fn print_call(call: int) {
        first = true
        for arg in ast.nodes[call].kids {
            if not first {
                emit(Instr(kind: "call", callee: "rt::PrintSep"))
            }
            first = false
            if ast.nodes[arg].kids.len() < 1 {
                stop("an argument with no value")
                return
            }
            node = ast.nodes[arg].kids[0]
            if ast.nodes[node].kind == "Interp" {
                // The interpolation is already a reference: print it, then release the
                // value it owns.
                operand = interp(node)
                if not ok {
                    return
                }
                emit(Instr(kind: "call", callee: "rt::PrintStr", args: [operand]))
                emit(Instr(kind: "release", args: [operand]))
                continue
            }
            operand = expr(node)
            if not ok {
                return
            }
            if kind_of(operand) == "?" {
                continue
            }
            emit(Instr(kind: "call", callee: print_primitive(operand), args: [operand]))
            // A variable lives to the end of the function; an intermediate dies here.
            if operand.is_temp and main.temps[operand.index].kind == "ref" and main.temps[operand.index].name == "" {
                emit(Instr(kind: "release", args: [operand]))
            }
        }
        emit(Instr(kind: "call", callee: "rt::PrintNl"))
    }

    /// An interpolation as one owned reference: its pieces are lowered where they are
    /// concatenated, in order, with the head becoming the accumulator.
    fn interp(id: int) -> Operand {
        acc = Operand()
        have = false
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            piece = Piece(op: Operand())
            if kind == "Lit" {
                text = ast.attr_text(kid, "text")
                if text == "" {
                    continue
                }
                piece = Piece(op: Operand(value: Value(kind: "str", str_value: text)))
            } else if kind == "Hole" {
                piece = hole(kid)
                if not ok {
                    return Operand()
                }
            } else {
                stop("a piece of an interpolation that is a `${kind}`")
                return Operand(value: Value(kind: "?"))
            }
            if not have {
                // The head is the accumulator, and the accumulation owns it: a borrowed
                // variable is retained for that, a literal needs nothing.
                acc = piece.op
                have = true
                if acc.is_temp and not piece.owned {
                    emit(Instr(kind: "retain", args: [acc]))
                }
                continue
            }
            index = temp("", "ref")
            emit(Instr(kind: "call", dest: index, callee: "rt::StrConcat", args: [acc, piece.op]))
            emit(Instr(kind: "release", args: [acc]))
            if piece.owned {
                emit(Instr(kind: "release", args: [piece.op]))
            }
            acc = Operand(is_temp: true, index: index)
        }
        if not have {
            stop("an interpolation with nothing in it")
        }
        return acc
    }

    /// `if`/`else`: the condition first, then a branch into the then-block, whose end
    /// and the else-block's end both jump to the join.
    fn if_stmt(id: int) {
        kids = ast.nodes[id].kids
        if kids.len() == 0 {
            stop("an `if` without a condition")
            return
        }
        cond = expr(kids[0])
        if not ok {
            return
        }
        if kind_of(cond) == "?" {
            // The condition is already reported; walk the bodies for their own.
            for kid in kids {
                if ast.nodes[kid].kind == "Then" or ast.nodes[kid].kind == "Else" {
                    body(kid)
                }
            }
            return
        }
        if kind_of(cond) != "bool" {
            stop("an `if` on a `${kind_of(cond)}`")
            return
        }
        then_node = -1
        else_node = -1
        for kid in kids {
            if ast.nodes[kid].kind == "Then" {
                then_node = kid
            } else if ast.nodes[kid].kind == "Else" {
                else_node = kid
            }
        }
        if then_node < 0 {
            stop("an `if` without a body")
            return
        }
        // The then-block, then the join, then the else-block: the oracle's numbering.
        then_bb = new_block()
        join = new_block()
        else_bb = join
        if else_node >= 0 {
            else_bb = new_block()
        }
        emit(Instr(kind: "branch", args: [cond], target: then_bb.label, alt: else_bb.label))
        switch_to(then_bb)
        body(then_node)
        if ok {
            emit(Instr(kind: "goto", target: join.label))
        }
        if ok and else_node >= 0 {
            switch_to(else_bb)
            body(else_node)
            if ok {
                emit(Instr(kind: "goto", target: join.label))
            }
        }
        switch_to(join)
    }

    /// `while`: condition block, body block, exit block, in that order.
    fn while_stmt(id: int) {
        kids = ast.nodes[id].kids
        if kids.len() != 2 {
            stop("a `while` without a condition and a body")
            return
        }
        cond_bb = new_block()
        body_bb = new_block()
        exit_bb = new_block()
        emit(Instr(kind: "goto", target: cond_bb.label))
        switch_to(cond_bb)
        cond = expr(kids[0])
        if not ok {
            return
        }
        if kind_of(cond) == "?" {
            // As in `if`: the condition is reported, the body still gets walked.
            body(kids[1])
            return
        }
        if kind_of(cond) != "bool" {
            stop("a `while` on a `${kind_of(cond)}`")
            return
        }
        emit(Instr(kind: "branch", args: [cond], target: body_bb.label, alt: exit_bb.label))
        switch_to(body_bb)
        break_to.add(exit_bb.label)
        continue_to.add(cond_bb.label)
        body(kids[1])
        break_to.pop()
        continue_to.pop()
        if ok {
            emit(Instr(kind: "goto", target: cond_bb.label))
        }
        switch_to(exit_bb)
    }

    fn body(id: int) {
        for kid in ast.nodes[id].kids {
            if not ok {
                return
            }
            stmt(kid)
        }
    }

    /// A hole: a name, as itself for a string or through `IntToStr` for an int.
    fn hole(id: int) -> Piece {
        kids = ast.nodes[id].kids
        if kids.len() != 1 {
            stop("a hole without one value")
            return Piece(op: Operand(value: Value(kind: "?")))
        }
        node = kids[0]
        if ast.nodes[node].kind != "Ident" {
            stop("a hole that is a `${ast.nodes[node].kind}`")
            return Piece(op: Operand(value: Value(kind: "?")))
        }
        name = ast.attr_text(node, "name")
        index = slot(name)
        if index < 0 {
            if not has_name(unknown_names, name) {
                stop("a hole reading `${name}`, which this slice cannot bind")
            }
            return Piece(op: Operand(value: Value(kind: "?")))
        }
        if main.temps[index].kind == "ref" {
            return Piece(op: Operand(is_temp: true, index: index))
        }
        if main.temps[index].kind != "int" {
            stop("a `${main.temps[index].kind}` hole")
            return Piece(op: Operand())
        }
        text = temp("", "ref")
        emit(Instr(kind: "call", dest: text, callee: "rt::IntToStr", args: [Operand(is_temp: true, index: index)]))
        return Piece(op: Operand(is_temp: true, index: text), owned: true)
    }

    /// An expression as an operand: a literal, a name, or a `+` of two of those.
    fn expr(id: int) -> Operand {
        kind = ast.nodes[id].kind
        if kind == "Int" or kind == "Float" or kind == "Bool" or kind == "Str" {
            return Operand(value: literal(id))
        }
        if kind == "Ident" {
            name = ast.attr_text(id, "name")
            index = slot(name)
            if index < 0 {
                if not has_name(unknown_names, name) {
                    stop("a read of `${name}`, which this slice cannot bind")
                }
                return Operand(value: Value(kind: "?"))
            }
            return Operand(is_temp: true, index: index)
        }
        if kind == "Binary" {
            return binary(id)
        }
        stop("an expression of kind `${kind}`")
        return Operand(value: Value(kind: "?"))
    }

    /// `a <op> b`: `+` on strings is a concat, the five integer operators are one
    /// instruction each.
    fn binary(id: int) -> Operand {
        op = ast.attr_raw(id, "op")
        kids = ast.nodes[id].kids
        if kids.len() != 2 {
            stop("a `${op}` without two operands")
            return Operand(value: Value(kind: "?"))
        }
        left = expr(kids[0])
        right = expr(kids[1])
        if not ok {
            return Operand(value: Value(kind: "?"))
        }
        left_kind = kind_of(left)
        right_kind = kind_of(right)
        // An operand that was already reported is not a second finding.
        if left_kind == "?" or right_kind == "?" {
            return Operand(value: Value(kind: "?"))
        }
        if op == "+" and (left_kind == "str" or right_kind == "str") {
            if left_kind != "str" or right_kind != "str" {
                stop("`+` between a `${left_kind}` and a `${right_kind}`")
                return Operand(value: Value(kind: "?"))
            }
            index = temp("", "ref")
            emit(Instr(kind: "call", dest: index, callee: "rt::StrConcat", args: [left, right]))
            return Operand(is_temp: true, index: index)
        }
        if compare_name(op) != "" {
            if left_kind != "int" or right_kind != "int" {
                stop("`${op}` on a `${left_kind}` and a `${right_kind}`")
                return Operand(value: Value(kind: "?"))
            }
            index = temp("", "bool")
            emit(Instr(kind: compare_name(op), dest: index, args: [left, right]))
            return Operand(is_temp: true, index: index)
        }
        mnemonic = operator_name(op)
        if mnemonic == "" {
            stop("the operator `${op}`, which this slice cannot lower")
            return Operand(value: Value(kind: "?"))
        }
        if left_kind != "int" or right_kind != "int" {
            stop("`${op}` on a `${left_kind}` and a `${right_kind}`")
            return Operand(value: Value(kind: "?"))
        }
        index = temp("", "int")
        emit(Instr(kind: mnemonic, dest: index, args: [left, right]))
        return Operand(is_temp: true, index: index)
    }

    fn literal(id: int) -> Value {
        kind = ast.nodes[id].kind
        if kind == "Int" {
            return Value(kind: "int", int_value: parse_int(ast.attr_raw(id, "value")))
        }
        if kind == "Float" {
            text = ast.attr_text(id, "value")
            return Value(kind: "float", float_value: text.to_float() catch e {
                    0.0
            })
        }
        if kind == "Bool" {
            return Value(kind: "bool", bool_value: ast.attr_raw(id, "value") == "true")
        }
        return Value(kind: "str", str_value: ast.attr_text(id, "value"))
    }
}

/// The instruction a comparison becomes, or "" when the operator is not one.
fn compare_name(op: string) -> string {
    if op == "<" {
        return "lt"
    }
    if op == "<=" {
        return "le"
    }
    if op == ">" {
        return "gt"
    }
    if op == ">=" {
        return "ge"
    }
    if op == "==" {
        return "eq"
    }
    if op == "!=" {
        return "ne"
    }
    return ""
}

/// The instruction a written operator becomes, or "" when this slice has no such
/// instruction (`div` truncates toward zero, which is what Kode's own `/` does).
fn operator_name(op: string) -> string {
    if op == "+" {
        return "add"
    }
    if op == "-" {
        return "sub"
    }
    if op == "*" {
        return "mul"
    }
    if op == "/" {
        return "div"
    }
    if op == "%" {
        return "rem"
    }
    return ""
}

/// The temporary kind a value's kind needs: a string is a reference.
fn temp_kind(kind: string) -> string {
    if kind == "str" {
        return "ref"
    }
    return "int"
}

/// Lower a program: every declared function, in declaration order, then `<main>`.
pub fn build(ast: Ast, collecting: bool) -> Mir {
    mir = Mir()
    entry = Block(label: "bb0")
    b = Builder(ast: ast, main: Function(name: "<main>", entry: true), entry: entry, block: entry, end: Block(label: "bb1"), collecting: collecting)
    if ast.nodes.len() > 0 {
        for id in ast.nodes[0].kids {
            if ast.nodes[id].kind == "Fn" {
                fn_item(b, id, mir)
                if not mir.ok {
                    return mir
                }
                continue
            }
            b.stmt(id)
        }
    }
    if not b.ok {
        mir.ok = false
        mir.why = b.why
        return mir
    }
    finish(b)
    mir.functions.add(b.main)
    add_problems(mir, b.problems)
    return mir
}

/// One `fn` declaration: its parameters become `_0`, `_1`, ..., its body is walked
/// with a builder of its own (the names and temporaries are the function's own), and
/// it returns through `bb1`.
fn fn_item(parent: Builder, id: int, mir: Mir) {
    ast = parent.ast
    f = Function(name: ast.attr_text(id, "name"))
    entry = Block(label: "bb0")
    b = Builder(ast: ast, main: f, entry: entry, block: entry, end: Block(label: "bb1"), collecting: parent.collecting)
    b.block_body = true
    body = -1
    for kid in ast.nodes[id].kids {
        kind = ast.nodes[kid].kind
        if kind == "Param" {
            slot = annotation_slot(ast, kid)
            if slot == "" {
                b.stop("a parameter of type `${annotation_text(ast, kid)}`")
                slot = "int"
            }
            index = b.temp("", slot)
            f.params.add(index)
            b.names.add(ast.attr_text(kid, "name"))
            b.slots.add(index)
            continue
        }
        if kind == "TypeName" {
            slot = annotation_slot(ast, kid)
            if slot == "" {
                b.stop("a return type of `${annotation_text(ast, kid)}`")
                slot = "int"
            }
            b.ret_kind = slot
            continue
        }
        if kind == "Block" {
            body = kid
        } else if kind == "ExprBody" {
            body = kid
            b.block_body = false
        }
    }
    f.ret = b.ret_kind
    if body >= 0 {
        if ast.nodes[body].kind == "ExprBody" {
            b.ret_expr(body)
        } else {
            for kid in ast.nodes[body].kids {
                b.stmt(kid)
            }
        }
    }
    if not b.ok {
        mir.ok = false
        mir.why = b.why
        return
    }
    finish(b)
    mir.functions.add(f)
    add_problems(mir, b.problems)
}

/// Assemble what the walk built: the fallthrough into `bb1`, the zero-initialised
/// entry block, the return block with its releases, the walk's blocks, and — for a
/// body that returns something — the `unreachable` block.
fn finish(b: Builder) {
    tail_unreachable = false
    if b.ret_kind == "unit" {
        // The block the walk ends in falls out to the return block.
        if not b.terminated() {
            b.emit(Instr(kind: "goto", target: "bb1"))
        }
    } else if b.block_body {
        // A body that returns something never falls out: when the walk ended in a
        // terminated block, a fresh block nothing can reach closes the function.
        if b.terminated() {
            tail_unreachable = true
        } else {
            b.emit(Instr(kind: "unreachable"))
        }
    }
    // The entry opens with one zero per temporary, in index order: `0` for an int,
    // `false` for a bool and `null` for a reference.
    head: [Instr] = []
    for k in 0..b.main.temps.len() {
        // A parameter arrives with its value; only the walk's own temporaries start
        // at zero.
        if is_param(b.main, k) {
            continue
        }
        head.add(zero_init(k, b.main.temps[k].kind))
    }
    for one in b.entry.instrs {
        head.add(one)
    }
    b.main.blocks.add(Block(label: "bb0", instrs: head))
    // Every named reference is released once on the way out.
    for k in 0..b.main.temps.len() {
        if b.main.temps[k].kind == "ref" and b.main.temps[k].name != "" {
            b.end.instrs.add(Instr(kind: "release", args: [Operand(is_temp: true, index: k)]))
        }
    }
    if b.ret_kind == "unit" or b.ret_temp < 0 {
        b.end.instrs.add(Instr(kind: "return"))
    } else {
        b.end.instrs.add(Instr(kind: "return", args: [Operand(is_temp: true, index: b.ret_temp)]))
    }
    b.main.blocks.add(b.end)
    for extra in b.blocks {
        b.main.blocks.add(extra)
    }
    if tail_unreachable {
        b.main.blocks.add(Block(label: "bb${b.next_label}", instrs: [Instr(kind: "unreachable")]))
    }
}

/// The slot kind an annotation needs, or "" when this slice cannot lower it: a
/// parameter's type is its child, a return type is the `TypeName` itself.
fn annotation_slot(ast: Ast, id: int) -> string {
    node = id
    if ast.nodes[id].kind == "Param" {
        if ast.nodes[id].kids.len() == 0 {
            return ""
        }
        node = ast.nodes[id].kids[0]
    }
    if ast.nodes[node].kind != "TypeName" {
        return ""
    }
    name = ast.attr_text(node, "name")
    if name == "int" {
        return "int"
    }
    if name == "bool" {
        return "bool"
    }
    if name == "float" {
        return "float"
    }
    if name == "string" {
        return "ref"
    }
    return ""
}

/// The annotation's own text, for the refusal that names it.
fn annotation_text(ast: Ast, id: int) -> string {
    node = id
    if ast.nodes[id].kind == "Param" {
        if ast.nodes[id].kids.len() == 0 {
            return "?"
        }
        node = ast.nodes[id].kids[0]
    }
    return ast.attr_text(node, "name")
}

/// Merge a walk's findings into the program's, keeping the first-seen order.
fn add_problems(mir: Mir, found: [string]) {
    for reason in found {
        seen = false
        for one in mir.problems {
            if one == reason {
                seen = true
            }
        }
        if not seen {
            mir.problems.add(reason)
        }
    }
}

/// The initialising assignment a temporary starts with.
fn zero_init(k: int, kind: string) -> Instr {
    start = Value(kind: "int")
    if kind == "ref" {
        start = Value(kind: "null")
    } else if kind == "bool" {
        start = Value(kind: "bool")
    }
    return Instr(kind: "assign", dest: k, args: [Operand(value: start)])
}
