// The MIR an interpreter runs (S4): `kode mir`'s first two shapes.
//
// Slice 1 lowered `print` of scalar literals. Slice 2 adds a local — `x = <int
// expression>` — and `+`, so the function now has temporaries, and the oracle's
// rules for them are exact:
//
//   * every variable and every intermediate `+` gets one temporary, numbered in the
//     order the program is walked; printing a string, bool or float literal directly
//     gets none;
//   * the `let` lines come before `bb0:`, with the variable's own name as a comment
//     (`    let _0: int  // x`) and none for an intermediate (`    let _1: int`);
//   * `bb0` opens with one `_N = 0` per temporary, in index order, then the code;
//   * `a + b` lowers `a`, then `b`, then emits `_N = add a, b`, where an operand
//     prints as itself (`1`) or as its temporary (`_0`).
//
// Slice 4 makes a string a reference (`ref`), which is what the retain/release lines
// are about:
//
//   * a string temporary is `    let _0: ref` and is zeroed to `_0 = null`;
//   * storing into a string variable releases the old value first, always, including
//     the first store over the null (`release _0`, then `_0 = "a"`);
//   * an intermediate reference is released at its last use (`call rt::PrintStr(_1)`
//     then `release _1`), while a variable is released once in `bb1`, in index order;
//   * `x + y` on strings is `_N = call rt::StrConcat(x, y)`; a literal argument is
//     borrowed, and a result stored into a variable is moved, not released.
//
// Slice 5 adds interpolation as a `print` argument: the pieces are its non-empty
// literals and holes, the head becomes the accumulator (a literal head is released
// after its first concat, a variable head is retained first), each following piece is
// a `StrConcat` whose old accumulator is released and whose int hole — an owned
// `IntToStr` temporary — is released too, and a lone hole is only a `retain`.
//
// Slice 6 adds comparisons and `if`, the first shapes with more than one block: the
// entry is `bb0`, the exit (releases and `return`) is `bb1`, and the blocks the walk
// creates follow in creation order — an `if` makes its then-block, its join, and then
// its else-block when there is one, each ending in `goto <join>`, with
// `branch _1, <then>, <else>` at the split.
//
// A statement outside those shapes sets `ok = false` with a reason, and `main.kode`
// says so and exits 2 rather than printing a MIR that would not run.

from "./ast" import Ast
from "./literals" import parse_int

/// A literal an instruction carries, with the value it stands for.
pub class Value {
    kind: string
    int_value: int = 0
    float_value: float = 0.0
    bool_value: bool = false
    str_value: string = ""
}

/// An instruction's argument: a literal, or the temporary that holds a value.
pub class Operand {
    is_temp: bool = false
    index: int = 0
    value: Value = Value(kind: "any")
}

/// A piece of an interpolation: an operand, and whether the concatenation owns it
/// (a hole that became a temporary) or only borrows it (a variable, a literal).
pub class Piece {
    op: Operand
    owned: bool = false
}

/// One instruction: an assignment (`dest = arg`), an `add` into `dest`, a call, a
/// `goto` or a `return`.
pub class Instr {
    kind: string
    dest: int = -1
    callee: string = ""
    args: [Operand] = []
    target: string = ""
    alt: string = ""
}

pub class Block {
    label: string
    instrs: [Instr] = []
}

/// One temporary: its type, and the variable whose name it is (empty for an
/// intermediate, which the dump leaves uncommented).
pub class Temp {
    kind: string = "int"
    name: string = ""
}

pub class Function {
    name: string
    ret: string = "unit"
    entry: bool = false
    temps: [Temp] = []
    blocks: [Block] = []
}

pub class Mir {
    functions: [Function] = []
    /// False when the program is outside this slice; `why` says which part.
    ok: bool = true
    why: string = ""
}

/// The lowering state: the tree, the function being filled, and the names in scope.
pub class Builder {
    ast: Ast
    main: Function
    block: Block
    /// The exit block (`bb1`), where the walk's last block jumps.
    end: Block
    /// The blocks the walk created, in creation order; the dump keeps that order.
    blocks: [Block] = []
    next_label: int = 2
    names: [string] = []
    slots: [int] = []
    ok: bool = true
    why: string = ""

    /// A fresh block, labelled in creation order after the entry and the exit.
    fn new_block() -> Block {
        b = Block(label: "bb${next_label}")
        next_label += 1
        blocks.add(b)
        return b
    }

    fn switch_to(b: Block) {
        block = b
    }

    /// A new temporary, of the given kind, optionally the variable it belongs to.
    fn temp(name: string, kind: string) -> int {
        index = main.temps.len()
        main.temps.add(Temp(kind: kind, name: name))
        return index
    }

    fn slot(name: string) -> int {
        for k in 0..names.len() {
            if names[k] == name {
                return slots[k]
            }
        }
        return -1
    }

    /// The type of an operand's value: the temporary's, or the literal's kind. A
    /// reference temporary holds a string, so it reads as `str` here, while its slot
    /// stays declared `ref`.
    fn kind_of(o: Operand) -> string {
        if o.is_temp {
            if main.temps[o.index].kind == "ref" {
                return "str"
            }
            return main.temps[o.index].kind
        }
        return o.value.kind
    }

    /// The runtime call that prints a value of that kind.
    fn print_primitive(o: Operand) -> string {
        kind = kind_of(o)
        if kind == "int" {
            return "rt::PrintInt"
        }
        if kind == "float" {
            return "rt::PrintFloat"
        }
        if kind == "bool" {
            return "rt::PrintBool"
        }
        return "rt::PrintStr"
    }

    fn stop(reason: string) {
        if ok {
            ok = false
            why = reason
        }
    }

    fn stmt(id: int) {
        if not ok {
            return
        }
        kind = ast.nodes[id].kind
        if kind == "ExprStmt" {
            for kid in ast.nodes[id].kids {
                if ast.nodes[kid].kind != "Call" or ast.attr_text(kid, "callee") != "print" {
                    stop("a call other than `print`")
                    return
                }
                print_call(kid)
            }
            return
        }
        if kind == "Assign" {
            assign(id)
            return
        }
        if kind == "Block" {
            // A block is its statements, in place.
            for kid in ast.nodes[id].kids {
                stmt(kid)
            }
            return
        }
        if kind == "If" {
            if_stmt(id)
            return
        }
        stop("statement `${kind}`")
    }

    fn assign(id: int) {
        var_name = ""
        var_id = -1
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "TargetVar" {
                var_id = kid
                var_name = ast.attr_text(kid, "name")
            }
        }
        if var_id < 0 {
            stop("an assignment to something other than a name")
            return
        }
        value = ast.nodes[id].kids[ast.nodes[id].kids.len() - 1]
        if value == var_id {
            stop("an assignment with no value")
            return
        }
        // The oracle lowers the value first, so its temporaries come before the
        // variable's: `x = 1 + 2` is `_0 = add 1, 2` then `_1 = _0`.
        operand = expr(value)
        if not ok {
            return
        }
        kind = kind_of(operand)
        if kind != "int" and kind != "str" {
            stop("`${var_name}` holding a `${kind}`")
            return
        }
        slot_kind = temp_kind(kind)
        index = slot(var_name)
        if index < 0 {
            index = temp(var_name, slot_kind)
            names.add(var_name)
            slots.add(index)
        } else if main.temps[index].kind != slot_kind {
            stop("`${var_name}` changing from `${main.temps[index].kind}` to `${slot_kind}`")
            return
        }
        // A reference slot releases what it held before it is overwritten — for the
        // first store too, where the oracle releases the null it was zeroed with.
        if slot_kind == "ref" {
            block.instrs.add(Instr(kind: "release", args: [Operand(is_temp: true, index: index)]))
        }
        block.instrs.add(Instr(kind: "assign", dest: index, args: [operand]))
    }

    fn print_call(call: int) {
        first = true
        for arg in ast.nodes[call].kids {
            if not first {
                block.instrs.add(Instr(kind: "call", callee: "rt::PrintSep"))
            }
            first = false
            if ast.nodes[arg].kids.len() < 1 {
                stop("an argument with no value")
                return
            }
            node = ast.nodes[arg].kids[0]
            if ast.nodes[node].kind == "Interp" {
                // The interpolation is already a reference: print it, then release the
                // value it owns.
                operand = interp(node)
                if not ok {
                    return
                }
                block.instrs.add(Instr(kind: "call", callee: "rt::PrintStr", args: [operand]))
                block.instrs.add(Instr(kind: "release", args: [operand]))
                continue
            }
            operand = expr(node)
            if not ok {
                return
            }
            block.instrs.add(Instr(kind: "call", callee: print_primitive(operand), args: [operand]))
            // A variable lives to the end of the function; an intermediate dies here.
            if operand.is_temp and main.temps[operand.index].kind == "ref" and main.temps[operand.index].name == "" {
                block.instrs.add(Instr(kind: "release", args: [operand]))
            }
        }
        block.instrs.add(Instr(kind: "call", callee: "rt::PrintNl"))
    }

    /// An interpolation as one owned reference: its pieces are lowered where they are
    /// concatenated, in order, with the head becoming the accumulator.
    fn interp(id: int) -> Operand {
        acc = Operand()
        have = false
        for kid in ast.nodes[id].kids {
            kind = ast.nodes[kid].kind
            piece = Piece(op: Operand())
            if kind == "Lit" {
                text = ast.attr_text(kid, "text")
                if text == "" {
                    continue
                }
                piece = Piece(op: Operand(value: Value(kind: "str", str_value: text)))
            } else if kind == "Hole" {
                piece = hole(kid)
                if not ok {
                    return Operand()
                }
            } else {
                stop("a piece of an interpolation that is a `${kind}`")
                return Operand()
            }
            if not have {
                // The head is the accumulator, and the accumulation owns it: a borrowed
                // variable is retained for that, a literal needs nothing.
                acc = piece.op
                have = true
                if acc.is_temp and not piece.owned {
                    block.instrs.add(Instr(kind: "retain", args: [acc]))
                }
                continue
            }
            index = temp("", "ref")
            block.instrs.add(Instr(kind: "call", dest: index, callee: "rt::StrConcat", args: [acc, piece.op]))
            block.instrs.add(Instr(kind: "release", args: [acc]))
            if piece.owned {
                block.instrs.add(Instr(kind: "release", args: [piece.op]))
            }
            acc = Operand(is_temp: true, index: index)
        }
        if not have {
            stop("an interpolation with nothing in it")
        }
        return acc
    }

    /// `if`/`else`: the condition first, then a branch into the then-block, whose end
    /// and the else-block's end both jump to the join.
    fn if_stmt(id: int) {
        kids = ast.nodes[id].kids
        if kids.len() == 0 {
            stop("an `if` without a condition")
            return
        }
        cond = expr(kids[0])
        if not ok {
            return
        }
        if kind_of(cond) != "bool" {
            stop("an `if` on a `${kind_of(cond)}`")
            return
        }
        then_node = -1
        else_node = -1
        for kid in kids {
            if ast.nodes[kid].kind == "Then" {
                then_node = kid
            } else if ast.nodes[kid].kind == "Else" {
                else_node = kid
            }
        }
        if then_node < 0 {
            stop("an `if` without a body")
            return
        }
        // The then-block, then the join, then the else-block: the oracle's numbering.
        then_bb = new_block()
        join = new_block()
        else_bb = join
        if else_node >= 0 {
            else_bb = new_block()
        }
        block.instrs.add(Instr(kind: "branch", args: [cond], target: then_bb.label, alt: else_bb.label))
        switch_to(then_bb)
        body(then_node)
        if ok {
            block.instrs.add(Instr(kind: "goto", target: join.label))
        }
        if ok and else_node >= 0 {
            switch_to(else_bb)
            body(else_node)
            if ok {
                block.instrs.add(Instr(kind: "goto", target: join.label))
            }
        }
        switch_to(join)
    }

    fn body(id: int) {
        for kid in ast.nodes[id].kids {
            if not ok {
                return
            }
            stmt(kid)
        }
    }

    /// A hole: a name, as itself for a string or through `IntToStr` for an int.
    fn hole(id: int) -> Piece {
        kids = ast.nodes[id].kids
        if kids.len() != 1 {
            stop("a hole without one value")
            return Piece(op: Operand())
        }
        node = kids[0]
        if ast.nodes[node].kind != "Ident" {
            stop("a hole that is a `${ast.nodes[node].kind}`")
            return Piece(op: Operand())
        }
        name = ast.attr_text(node, "name")
        index = slot(name)
        if index < 0 {
            stop("a hole reading `${name}`, which this slice cannot bind")
            return Piece(op: Operand())
        }
        if main.temps[index].kind == "ref" {
            return Piece(op: Operand(is_temp: true, index: index))
        }
        if main.temps[index].kind != "int" {
            stop("a `${main.temps[index].kind}` hole")
            return Piece(op: Operand())
        }
        text = temp("", "ref")
        block.instrs.add(Instr(kind: "call", dest: text, callee: "rt::IntToStr", args: [Operand(is_temp: true, index: index)]))
        return Piece(op: Operand(is_temp: true, index: text), owned: true)
    }

    /// An expression as an operand: a literal, a name, or a `+` of two of those.
    fn expr(id: int) -> Operand {
        kind = ast.nodes[id].kind
        if kind == "Int" or kind == "Float" or kind == "Bool" or kind == "Str" {
            return Operand(value: literal(id))
        }
        if kind == "Ident" {
            name = ast.attr_text(id, "name")
            index = slot(name)
            if index < 0 {
                stop("a read of `${name}`, which this slice cannot bind")
                return Operand()
            }
            return Operand(is_temp: true, index: index)
        }
        if kind == "Binary" {
            return binary(id)
        }
        stop("an expression of kind `${kind}`")
        return Operand()
    }

    /// `a <op> b`: `+` on strings is a concat, the five integer operators are one
    /// instruction each.
    fn binary(id: int) -> Operand {
        op = ast.attr_raw(id, "op")
        kids = ast.nodes[id].kids
        if kids.len() != 2 {
            stop("a `${op}` without two operands")
            return Operand()
        }
        left = expr(kids[0])
        right = expr(kids[1])
        if not ok {
            return Operand()
        }
        left_kind = kind_of(left)
        right_kind = kind_of(right)
        if op == "+" and (left_kind == "str" or right_kind == "str") {
            if left_kind != "str" or right_kind != "str" {
                stop("`+` between a `${left_kind}` and a `${right_kind}`")
                return Operand()
            }
            index = temp("", "ref")
            block.instrs.add(Instr(kind: "call", dest: index, callee: "rt::StrConcat", args: [left, right]))
            return Operand(is_temp: true, index: index)
        }
        if compare_name(op) != "" {
            if left_kind != "int" or right_kind != "int" {
                stop("`${op}` on a `${left_kind}` and a `${right_kind}`")
                return Operand()
            }
            index = temp("", "bool")
            block.instrs.add(Instr(kind: compare_name(op), dest: index, args: [left, right]))
            return Operand(is_temp: true, index: index)
        }
        mnemonic = operator_name(op)
        if mnemonic == "" {
            stop("the operator `${op}`, which this slice cannot lower")
            return Operand()
        }
        if left_kind != "int" or right_kind != "int" {
            stop("`${op}` on a `${left_kind}` and a `${right_kind}`")
            return Operand()
        }
        index = temp("", "int")
        block.instrs.add(Instr(kind: mnemonic, dest: index, args: [left, right]))
        return Operand(is_temp: true, index: index)
    }

    fn literal(id: int) -> Value {
        kind = ast.nodes[id].kind
        if kind == "Int" {
            return Value(kind: "int", int_value: parse_int(ast.attr_raw(id, "value")))
        }
        if kind == "Float" {
            text = ast.attr_text(id, "value")
            return Value(kind: "float", float_value: text.to_float() catch e {
                    0.0
            })
        }
        if kind == "Bool" {
            return Value(kind: "bool", bool_value: ast.attr_raw(id, "value") == "true")
        }
        return Value(kind: "str", str_value: ast.attr_text(id, "value"))
    }
}

/// The instruction a comparison becomes, or "" when the operator is not one.
fn compare_name(op: string) -> string {
    if op == "<" {
        return "lt"
    }
    if op == "<=" {
        return "le"
    }
    if op == ">" {
        return "gt"
    }
    if op == ">=" {
        return "ge"
    }
    if op == "==" {
        return "eq"
    }
    if op == "!=" {
        return "ne"
    }
    return ""
}

/// The instruction a written operator becomes, or "" when this slice has no such
/// instruction (`div` truncates toward zero, which is what Kode's own `/` does).
fn operator_name(op: string) -> string {
    if op == "+" {
        return "add"
    }
    if op == "-" {
        return "sub"
    }
    if op == "*" {
        return "mul"
    }
    if op == "/" {
        return "div"
    }
    if op == "%" {
        return "rem"
    }
    return ""
}

/// The temporary kind a value's kind needs: a string is a reference.
fn temp_kind(kind: string) -> string {
    if kind == "str" {
        return "ref"
    }
    return "int"
}

/// Lower a program to the one function these slices can build.
pub fn build(ast: Ast) -> Mir {
    mir = Mir()
    main = Function(name: "<main>", entry: true)
    entry = Block(label: "bb0")
    exit = Block(label: "bb1")
    b = Builder(ast: ast, main: main, block: entry, end: exit)
    if ast.nodes.len() > 0 {
        for id in ast.nodes[0].kids {
            b.stmt(id)
        }
    }
    if not b.ok {
        return Mir(functions: [], ok: false, why: b.why)
    }
    // The block the walk ends in falls out to the exit.
    b.block.instrs.add(Instr(kind: "goto", target: "bb1"))
    // The entry opens with one zero per temporary, in index order: `0` for an int,
    // `false` for a bool and `null` for a reference.
    head: [Instr] = []
    for k in 0..main.temps.len() {
        head.add(zero_init(k, main.temps[k].kind))
    }
    for one in entry.instrs {
        head.add(one)
    }
    main.blocks.add(Block(label: "bb0", instrs: head))
    // Every named reference is released once on the way out.
    for k in 0..main.temps.len() {
        if main.temps[k].kind == "ref" and main.temps[k].name != "" {
            exit.instrs.add(Instr(kind: "release", args: [Operand(is_temp: true, index: k)]))
        }
    }
    exit.instrs.add(Instr(kind: "return"))
    main.blocks.add(exit)
    for extra in b.blocks {
        main.blocks.add(extra)
    }
    mir.functions.add(main)
    return mir
}

/// The initialising assignment a temporary starts with.
fn zero_init(k: int, kind: string) -> Instr {
    start = Value(kind: "int")
    if kind == "ref" {
        start = Value(kind: "null")
    } else if kind == "bool" {
        start = Value(kind: "bool")
    }
    return Instr(kind: "assign", dest: k, args: [Operand(value: start)])
}

/// The dump's lines: the oracle's layout, the `let` block, then the blocks.
pub fn dump_lines(mir: Mir) -> [string] {
    lines: [string] = []
    for f in mir.functions {
        head = "fn ${f.name}() -> ${f.ret} {"
        if f.entry {
            head += "  // entry"
        }
        lines.add(head)
        for k in 0..f.temps.len() {
            line = "    let _${k}: ${f.temps[k].kind}"
            if f.temps[k].name != "" {
                line += "  // ${f.temps[k].name}"
            }
            lines.add(line)
        }
        for b in f.blocks {
            lines.add("  ${b.label}:")
            for i in b.instrs {
                lines.add("    ${instr_text(i)}")
            }
        }
        lines.add("}")
        // The oracle ends its dump with a blank line; `main` joins these with a
        // newline and `print` adds the last one.
        lines.add("")
    }
    return lines
}

fn instr_text(i: Instr) -> string {
    if i.kind == "goto" {
        return "goto ${i.target}"
    }
    if i.kind == "return" {
        return "return"
    }
    if i.kind == "release" {
        return "release ${operand_text(i.args[0])}"
    }
    if i.kind == "retain" {
        return "retain ${operand_text(i.args[0])}"
    }
    if i.kind == "branch" {
        return "branch ${operand_text(i.args[0])}, ${i.target}, ${i.alt}"
    }
    if i.dest >= 0 {
        if i.kind == "assign" {
            return "_${i.dest} = ${operand_text(i.args[0])}"
        }
        if i.kind == "call" {
            return "_${i.dest} = call ${i.callee}(${call_args(i)})"
        }
        return "_${i.dest} = ${i.kind} ${operand_text(i.args[0])}, ${operand_text(i.args[1])}"
    }
    return "call ${i.callee}(${call_args(i)})"
}

fn call_args(i: Instr) -> string {
    parts = ""
    for arg in i.args {
        if parts != "" {
            parts += ", "
        }
        parts += operand_text(arg)
    }
    return parts
}

fn operand_text(o: Operand) -> string {
    if o.is_temp {
        return "_${o.index}"
    }
    return value_text(o.value)
}

/// A value the way the dump writes it: a string quoted, a float in its shortest form.
pub fn value_text(v: Value) -> string {
    if v.kind == "int" {
        return "${v.int_value}"
    }
    if v.kind == "float" {
        return "${v.float_value}"
    }
    if v.kind == "bool" {
        if v.bool_value {
            return "true"
        }
        return "false"
    }
    if v.kind == "str" {
        return "\"${quoted(v.str_value)}\""
    }
    return "null"
}

/// A value the way the program prints it: a string is its own text, where a dump
/// quotes and escapes it.
pub fn print_text(v: Value) -> string {
    if v.kind == "str" {
        return v.str_value
    }
    return value_text(v)
}

/// A string with the escapes a dump writes: quote, backslash, tab, newline, return.
fn quoted(text: string) -> string {
    out = ""
    for k in 0..text.size() {
        b = text.byte_at(k)
        if b == 34 {
            out += "\\\""
        } else if b == 92 {
            out += "\\\\"
        } else if b == 9 {
            out += "\\t"
        } else if b == 10 {
            out += "\\n"
        } else if b == 13 {
            out += "\\r"
        } else {
            out += text.slice(k, k + 1)
        }
    }
    return out
}
