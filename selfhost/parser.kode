// The parser of the self-hosted compiler: stage S2, slice 1.
//
// Slice 1 is the smallest tree that is still a tree: assignments of a literal or
// a name (`x = 1`), and call statements whose arguments are literals or names
// (`print(x, 2)`). Every later slice adds statements and expressions without
// changing the arena (ADR 0042), the dump format, or the way a statement is
// dispatched, so the tree this builds is the shape the rest of S2 fills in.

from "./ast" import Ast
from "./literals" import float_text, parse_int, parse_string
from "./tokens" import Lexed, Token, TokenKind

/// Binding powers: higher binds tighter (see the expression section below).
const BP_NOT = 9
const BP_UNARY = 30

/// One row of the infix table: the operator's dump symbol and its binding powers.
pub class Infix {
    op: string
    left: int
    right: int
}

/// The infix operators, at the precedence `parser/expr.rs` gives them. An empty
/// `op` means the token does not continue an expression.
fn infix_of(kind: TokenKind) -> Infix {
    if kind == TokenKind.Or {
        return Infix(op: "or", left: 2, right: 3)
    }
    if kind == TokenKind.And {
        return Infix(op: "and", left: 4, right: 5)
    }
    if kind == TokenKind.Pipe {
        return Infix(op: "|", left: 6, right: 7)
    }
    if kind == TokenKind.Caret {
        return Infix(op: "^", left: 7, right: 8)
    }
    if kind == TokenKind.Amp {
        return Infix(op: "&", left: 8, right: 9)
    }
    if kind == TokenKind.EqEq {
        return Infix(op: "==", left: 10, right: 11)
    }
    if kind == TokenKind.NotEq {
        return Infix(op: "!=", left: 10, right: 11)
    }
    if kind == TokenKind.Lt {
        return Infix(op: "<", left: 10, right: 11)
    }
    if kind == TokenKind.Le {
        return Infix(op: "<=", left: 10, right: 11)
    }
    if kind == TokenKind.Gt {
        return Infix(op: ">", left: 10, right: 11)
    }
    if kind == TokenKind.Ge {
        return Infix(op: ">=", left: 10, right: 11)
    }
    if kind == TokenKind.In {
        return Infix(op: "in", left: 10, right: 11)
    }
    if kind == TokenKind.Shl {
        return Infix(op: "<<", left: 12, right: 13)
    }
    if kind == TokenKind.Shr {
        return Infix(op: ">>", left: 12, right: 13)
    }
    if kind == TokenKind.Plus {
        return Infix(op: "+", left: 16, right: 17)
    }
    if kind == TokenKind.Minus {
        return Infix(op: "-", left: 16, right: 17)
    }
    if kind == TokenKind.Star {
        return Infix(op: "*", left: 20, right: 21)
    }
    if kind == TokenKind.Slash {
        return Infix(op: "/", left: 20, right: 21)
    }
    if kind == TokenKind.Percent {
        return Infix(op: "%", left: 20, right: 21)
    }
    return Infix(op: "", left: 0, right: 0)
}

/// A parse error, in the shape the lexer's errors already use.
pub class ParseError {
    code: string
    message: string
    start: int
    end: int
    help: string
}

pub class Parsed {
    ast: Ast
    errors: [ParseError] = []
}

/// Parse a token stream. Errors are collected, not thrown: the caller prints
/// them and exits, exactly as `kode ast` does.
pub fn parse(src: string, lx: Lexed) -> Parsed {
    p = Parser(src: src, tokens: lx.tokens, out: Parsed(ast: Ast()))
    return p.run()
}

pub class Parser {
    src: string
    tokens: [Token]
    out: Parsed
    at: int = 0
    last_end: int = 0

    fn run() -> Parsed {
        out.ast.add("Program")
        while not done() {
            step()
        }
        return out
    }

    // ---- token cursor ----

    fn peek() -> TokenKind {
        if at < tokens.len() {
            return tokens[at].kind
        }
        return TokenKind.Eof
    }

    fn peek_at(n: int) -> TokenKind {
        if at + n < tokens.len() {
            return tokens[at + n].kind
        }
        return TokenKind.Eof
    }

    fn done() -> bool {
        return peek() == TokenKind.Eof
    }

    fn advance() {
        if at < tokens.len() {
            last_end = tokens[at].end
            at += 1
        }
    }

    fn text_of(token: int) -> string {
        return src.slice(tokens[token].start, tokens[token].end)
    }

    fn fail(code: string, message: string, start: int, end: int, help: string) {
        out.errors.add(
            ParseError(code: code, message: message, start: start, end: end, help: help)
        )
    }

    /// Skip to the next statement boundary after an error.
    fn recover() {
        while not done() and peek() != TokenKind.Newline {
            advance()
        }
        if peek() == TokenKind.Newline {
            advance()
        }
    }

    // ---- statements ----

    fn step() {
        if peek() == TokenKind.Newline {
            advance()
            return
        }
        if peek() == TokenKind.Ident {
            if peek_at(1) == TokenKind.Assign {
                assign()
                return
            }
            if peek_at(1) == TokenKind.LParen {
                call_stmt()
                return
            }
        }
        token = at
        advance()
        fail(
            "E0102",
            "expected a statement, found `${text_of(token)}`",
            tokens[token].start,
            tokens[token].end,
            "slice 1 parses `name = value` and `name(args)`; other statements arrive next",
        )
        recover()
    }

    /// `x = 1`: the target is a `TargetVar`, its span the name's.
    fn assign() {
        name_id = at
        advance()
        advance()
        value = expr()
        id = out.ast.add("Assign")
        target = out.ast.counted("TargetVar")
        out.ast.text(target, "name", text_of(name_id))
        out.ast.span(target, "span", tokens[name_id].start, tokens[name_id].end)
        out.ast.kid(id, target)
        if value >= 0 {
            out.ast.kid(id, value)
            // The assignment spans its target and its value, so `x = (1)` ends
            // where the `1` ends, not where the `)` is.
            out.ast.span(id, "span", token_start(name_id), out.ast.nodes[value].end)
        } else {
            out.ast.span(id, "span", tokens[name_id].start, tokens[name_id].end)
        }
        out.ast.nodes[0].kids.add(id)
        end_line()
    }

    /// `print(x)`: an expression statement whose expression is a call.
    fn call_stmt() {
        value = expr()
        stmt = out.ast.add("ExprStmt")
        if value >= 0 {
            out.ast.kid(stmt, value)
        }
        out.ast.nodes[0].kids.add(stmt)
        end_line()
    }

    /// A statement ends at a newline. Anything else is a parse error.
    fn end_line() {
        if peek() == TokenKind.Newline {
            advance()
            return
        }
        if done() {
            return
        }
        token = at
        fail(
            "E0102",
            "expected the end of the statement, found `${text_of(token)}`",
            tokens[token].start,
            tokens[token].end,
            "one statement per line",
        )
        recover()
    }

    // ---- expressions ----
    //
    // Precedence follows `crates/kode-syntax/src/parser/expr.rs`: `or` 2, `and` 4,
    // `|` 6, `^` 7, `&` 8, comparisons and `in` 10, `<< >>` 12, `+ -` 16,
    // `* / %` 20, unary `-` and `~` 30, and `not` 9, so `not a == b` is
    // `not (a == b)`. A parenthesized expression adds no node: `(1 + 2)` *is* the
    // `Binary`, with its own span, which is what the oracle dumps.
    //
    // Slice 1 of the expression grammar ends at the operators: a name, a literal,
    // a call and a group. Indexing, members, method calls, lists, maps, `is`,
    // `??`, `catch`, closures and `await` are the next slice.

    fn expr() -> int {
        return expr_bp(0)
    }

    fn expr_bp(min_bp: int) -> int {
        lhs = prefix()
        if lhs < 0 {
            return lhs
        }
        while true {
            f = infix_of(peek())
            if f.op.len() == 0 or f.left < min_bp {
                break
            }
            advance()
            // A line may end after an operator.
            skip_newlines()
            rhs = expr_bp(f.right)
            if rhs < 0 {
                return lhs
            }
            id = out.ast.counted("Binary")
            out.ast.raw(id, "op", f.op)
            out.ast.kid(id, lhs)
            out.ast.kid(id, rhs)
            out.ast.span(id, "span", out.ast.nodes[lhs].start, out.ast.nodes[rhs].end)
            lhs = id
        }
        return lhs
    }

    /// A prefix operator (`-`, `~`, `not`) or a primary expression.
    fn prefix() -> int {
        kind = peek()
        if kind == TokenKind.Minus or kind == TokenKind.Tilde or kind == TokenKind.Not {
            op = "-"
            bp = BP_UNARY
            if kind == TokenKind.Tilde {
                op = "~"
            } else if kind == TokenKind.Not {
                op = "not"
                bp = BP_NOT
            }
            open_at = at
            advance()
            operand = expr_bp(bp)
            if operand < 0 {
                return operand
            }
            id = out.ast.counted("Unary")
            out.ast.raw(id, "op", op)
            out.ast.kid(id, operand)
            out.ast.span(
                id,
                "span",
                token_start(open_at),
                out.ast.nodes[operand].end,
            )
            return id
        }
        return primary()
    }

    fn primary() -> int {
        kind = peek()
        if kind == TokenKind.Int {
            token = at
            advance()
            id = out.ast.counted("Int")
            out.ast.num(id, "value", parse_int(text_of(token)))
            spans(id, token)
            return id
        }
        if kind == TokenKind.Float {
            token = at
            advance()
            id = out.ast.counted("Float")
            out.ast.text(id, "value", float_text(text_of(token)))
            spans(id, token)
            return id
        }
        if kind == TokenKind.Str {
            token = at
            advance()
            id = out.ast.counted("Str")
            out.ast.text(id, "value", parse_string(text_of(token)))
            spans(id, token)
            return id
        }
        if kind == TokenKind.True or kind == TokenKind.False {
            token = at
            advance()
            id = out.ast.counted("Bool")
            out.ast.flag(id, "value", kind == TokenKind.True)
            spans(id, token)
            return id
        }
        if kind == TokenKind.Ident {
            return call_or_name()
        }
        // `(1 + 2)`: the parentheses group and leave no node, only the inner
        // expression's own span.
        if kind == TokenKind.LParen {
            advance()
            skip_newlines()
            inner = expr()
            if inner < 0 {
                return inner
            }
            skip_newlines()
            if peek() == TokenKind.RParen {
                advance()
            } else {
                fail(
                    "E0102",
                    "expected `)` to close the group",
                    token_start(at),
                    token_end(at),
                    "every `(` needs a `)`",
                )
            }
            return inner
        }
        token = at
        fail(
            "E0102",
            "expected a value, found `${text_of(token)}`",
            token_start(token),
            token_end(token),
            "values are numbers, strings, bools, names, calls and groups",
        )
        recover()
        return -1
    }

    fn call_or_name() -> int {
        callee = at
        advance()
        if peek() != TokenKind.LParen {
            id = out.ast.counted("Ident")
            out.ast.text(id, "name", text_of(callee))
            spans(id, callee)
            return id
        }
        open_at = at
        advance()
        args: [int] = []
        while not done() and peek() != TokenKind.RParen {
            args.add(expr())
            if peek() == TokenKind.Comma {
                advance()
            } else {
                break
            }
        }
        if peek() == TokenKind.RParen {
            advance()
        } else {
            fail(
                "E0102",
                "expected `)` to close the call",
                token_start(open_at),
                token_end(open_at),
                "every `(` needs a `)`",
            )
        }
        id = out.ast.counted("Call")
        out.ast.text(id, "callee", text_of(callee))
        out.ast.span(id, "callee_span", token_start(callee), token_end(callee))
        for arg in args {
            if arg >= 0 {
                node = out.ast.add("Arg")
                out.ast.kid(node, arg)
                out.ast.kid(id, node)
            }
        }
        out.ast.span(id, "span", token_start(callee), last_end)
        return id
    }

    fn skip_newlines() {
        while peek() == TokenKind.Newline {
            advance()
        }
    }

    /// `span=a..b` for a one-token node.
    fn spans(id: int, token: int) {
        out.ast.span(id, "span", token_start(token), token_end(token))
    }

    fn token_start(token: int) -> int {
        if token < tokens.len() {
            return tokens[token].start
        }
        return src.size()
    }

    fn token_end(token: int) -> int {
        if token < tokens.len() {
            return tokens[token].end
        }
        return src.size()
    }
}
