// The statement parser of the self-hosted compiler: S2 slice 2.
//
// Statements are `name = value` and an expression on its own line. The
// expression grammar lives in `expr.kode`; this file owns the statement loop, the
// error recovery and the arena's root. Both parsers hold one `Cursor`, so the
// position and the error report are shared (ADR 0042 for the tree shape).

from "./ast" import Ast
from "./cursor" import Cursor, ParseError
from "./expr" import Exprs
from "./tokens" import Lexed, TokenKind

pub class Parsed {
    ast: Ast
    errors: [ParseError] = []
}

/// Parse a token stream. Errors are collected, not thrown: the caller prints
/// them and exits, exactly as `kode ast` does.
pub fn parse(src: string, lx: Lexed) -> Parsed {
    c = Cursor(src: src, tokens: lx.tokens)
    p = Parser(c: c, ast: Ast())
    return p.run()
}

pub class Parser {
    c: Cursor
    ast: Ast

    fn run() -> Parsed {
        ast.add("Program")
        while not c.done() {
            step()
        }
        return Parsed(ast: ast, errors: c.errors)
    }

    /// The expression parser over the same cursor, arena and error list.
    fn ex() -> Exprs {
        return Exprs(c: c, ast: ast)
    }

    // ---- statements ----

    fn step() {
        if c.peek() == TokenKind.Newline {
            c.advance()
            return
        }
        if c.peek() == TokenKind.Ident and c.peek_at(1) == TokenKind.Assign {
            assign()
            return
        }
        if starts_value(c.peek()) {
            expression_stmt()
            return
        }
        token = c.at
        c.advance()
        c.fail(
            "E0102",
            "expected a statement, found `${c.text_of(token)}`",
            c.token_start(token),
            c.token_end(token),
            "a statement is `name = value` or an expression; the rest arrive next",
        )
        recover()
    }

    /// `x = 1`: the target is a `TargetVar`, its span the name's, and the whole
    /// statement spans the target and the value.
    fn assign() {
        name_at = c.at
        c.advance()
        c.advance()
        value = ex().expr()
        id = ast.add("Assign")
        target = ast.counted("TargetVar")
        ast.text(target, "name", c.text_of(name_at))
        ast.span(target, "span", c.token_start(name_at), c.token_end(name_at))
        ast.kid(id, target)
        if value >= 0 {
            ast.kid(id, value)
            // `x = (1)` ends where the `1` ends, not where the `)` is.
            ast.span(id, "span", c.token_start(name_at), ast.nodes[value].end)
        } else {
            ast.span(id, "span", c.token_start(name_at), c.token_end(name_at))
        }
        ast.nodes[0].kids.add(id)
        end_line()
    }

    /// `print(x)`, `xs.add(1)`: an expression statement.
    fn expression_stmt() {
        value = ex().expr()
        stmt = ast.add("ExprStmt")
        if value >= 0 {
            ast.kid(stmt, value)
        }
        ast.nodes[0].kids.add(stmt)
        end_line()
    }

    /// A statement ends at a newline. Anything else is a parse error.
    fn end_line() {
        if c.peek() == TokenKind.Newline {
            c.advance()
            return
        }
        if c.done() {
            return
        }
        c.fail(
            "E0102",
            "expected the end of the statement, found `${c.text_of(c.at)}`",
            c.token_start(c.at),
            c.token_end(c.at),
            "one statement per line",
        )
        recover()
    }

    fn recover() {
        while not c.done() and c.peek() != TokenKind.Newline {
            c.advance()
        }
        if c.peek() == TokenKind.Newline {
            c.advance()
        }
    }
}

/// A token that can start a value. Anything else is a statement this slice does
/// not know, so it is reported rather than skipped silently.
fn starts_value(kind: TokenKind) -> bool {
    if kind == TokenKind.Int {
        return true
    }
    if kind == TokenKind.Float {
        return true
    }
    if kind == TokenKind.Str {
        return true
    }
    if kind == TokenKind.True or kind == TokenKind.False or kind == TokenKind.None {
        return true
    }
    if kind == TokenKind.Ident {
        return true
    }
    if kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace {
        return true
    }
    if kind == TokenKind.Minus or kind == TokenKind.Tilde or kind == TokenKind.Not {
        return true
    }
    return false
}
