// The signatures of the functions a program starts with (S3).
//
// `builtins.kode` answers whether a name exists; this answers what it takes. Three
// tables, because the oracle says three different things about them:
//
//   - a runtime function (`exec`, `read_file`) names its arguments positionally:
//     "argument 2 of `exec` should be `[string]`, found a string";
//   - a one-argument builtin (`bytes`, `len`) describes the value it wants:
//     "`bytes` expects a length, found a string";
//   - a method on a builtin class (`sb.push`) is the builtin form too: "`push`
//     expects a string, found an int".
//
// The source is `crates/kode-sema/src/std_fns.rs` (AGENTS.md: one row per
// function) and the builtin arms of `crates/kode-sema/src/check/expr.rs`. The port
// cannot read them, so this is a mirror; a row lands here when a fixture needs it.

from "./typing" import Type, type_of, type_prim

/// One row: a name, what it accepts, and how a message describes it.
///
/// `params` is the exact list a runtime function demands, used with the checker's
/// own assignability. `accepts` is the builtin form: the kinds a single argument may
/// be (`int`, `list`, ...), because `len` takes a list of anything.
pub class StdSig {
    name: string
    params: [Type] = []
    accepts: [string] = []
    /// The wording of a builtin's `expects`; "" means the parameter type's article.
    expects: string = ""
}

fn str_ty() -> Type {
    return type_prim("string")
}

fn int_ty() -> Type {
    return type_prim("int")
}

/// A runtime function called by name: `exec("cc", args, "")`.
pub fn free_fn(name: string) -> StdSig {
    if name == "read_file" {
        return StdSig(name: name, params: [str_ty()])
    }
    if name == "write_file" {
        return StdSig(name: name, params: [str_ty(), str_ty()])
    }
    if name == "args" {
        return StdSig(name: name)
    }
    if name == "env" {
        return StdSig(name: name, params: [str_ty()])
    }
    if name == "exit" or name == "sleep" or name == "chr" {
        return StdSig(name: name, params: [int_ty()])
    }
    if name == "now_ms" or name == "now_ns" {
        return StdSig(name: name)
    }
    if name == "exec" {
        return StdSig(name: name, params: [str_ty(), type_of("list", str_ty()), str_ty()])
    }
    return StdSig(name: "")
}

/// A one-argument builtin: `bytes(4)`, `len(x)`, `int(s)`.
pub fn builtin(name: string) -> StdSig {
    if name == "len" {
        return StdSig(name: name, params: [str_ty()], accepts: ["string", "list", "map"], expects: "a string, a list or a map")
    }
    if name == "bytes" {
        return StdSig(name: name, params: [int_ty()], accepts: ["int"], expects: "a length")
    }
    if name == "int" {
        return StdSig(name: name, params: [int_ty()], accepts: ["int", "float", "bool"], expects: "an int, float or bool")
    }
    if name == "float" {
        return StdSig(name: name, params: [int_ty()], accepts: ["int", "float"], expects: "an int or float")
    }
    if name == "string" {
        return StdSig(name: name, params: [str_ty()], accepts: ["int", "float", "bool", "string"], expects: "an int, float or string")
    }
    if name == "assert" {
        return StdSig(name: name, params: [int_ty()], accepts: ["bool"], expects: "a bool")
    }
    return StdSig(name: "")
}

/// A method of a builtin class: `StringBuilder.push(s)` and `build()`.
pub fn builder_method(name: string) -> StdSig {
    if name == "push" {
        return StdSig(name: name, params: [str_ty()], accepts: ["string"])
    }
    if name == "build" {
        return StdSig(name: name)
    }
    return StdSig(name: "")
}
