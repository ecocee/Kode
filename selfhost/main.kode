// The self-hosted compiler's entry point (stage S1 of
// docs/PLAN-self-hosting.md).
//
//   kode-stage1 tokens <file.kode>
//   kode-stage1 ast <file.kode>
//   kode-stage1 check <file.kode>
//
// `check` is the first slice of S3 (`selfhost/sema.kode`): name resolution only, so
// its diagnostics are codes and messages until the JSON format lands.

from "./ast" import ast_lines
from "./dump" import position, tokens_lines
from "./lexer" import lex
from "./modules" import Loader
from "./parser" import parse
from "./report" import from_lex, render, render_diag
from "./sema" import Sema

argv = args()

if argv.len() == 0 {
    print("usage: kode-stage1 tokens <file.kode>")
    exit(2)
}

command = argv[0]

if command != "tokens" and command != "ast" and command != "check" {
    print("kode-stage1: `${command}` is not implemented yet; `tokens`, `ast` and `check` exist")
    exit(2)
}

if argv.len() < 2 {
    print("kode-stage1: `${command}` needs a file name")
    exit(2)
}

file = argv[1]
src = ""
try {
    src = read_file(file)
} catch e {
    print("kode-stage1: cannot read ${file}: ${e.message}")
    exit(1)
}

lx = lex(src)

if lx.errors.len() > 0 {
    // Diagnostics belong on stderr, and `kode tokens` puts them there. Each
    // report ends with a newline of its own, and `stderr` adds one, so the
    // stream gets a blank line between reports exactly like the oracle
    // (`stderr` is WP-10, ADR 0045).
    for err in lx.errors {
        stderr(render(file, src, from_lex(err)))
    }
    exit(1)
}

if command == "check" {
    // The checker needs the whole program, not one file: free functions and
    // constants share one namespace across modules (`modules.kode`).
    graph = Loader().graph(file, src)
    if graph.problems.len() > 0 {
        for problem in graph.problems {
            stderr(render(problem.file, problem.src, problem.err))
        }
        exit(1)
    }
    checker = Sema(asts: graph.asts, mods: graph.modules, aliases: graph.aliases)
    checker.run()
    errors = 0
    for diag in checker.diags {
        src_of = src
        if diag.file != "" and diag.file != file {
            src_of = read_file(diag.file)
        }
        stderr(render_diag(diag.file, src_of, diag))
        if not diag.warning {
            errors += 1
        }
    }
    if errors > 0 {
        exit(1)
    }
    stderr("ok: ${file} has no errors")
    exit(0)
}

if command == "ast" {
    parsed = parse(src, lx)
    if parsed.errors.len() > 0 {
        for err in parsed.errors {
            stderr(render(file, src, err))
        }
        exit(1)
    }
    print(ast_lines(parsed.ast).join("\n"))
    exit(0)
}

// The dump ends with a newline, and `print` adds one, so the lines are joined
// without a trailing empty one.
print(tokens_lines(src, lx).join("\n"))
