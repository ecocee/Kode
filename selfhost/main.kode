// The self-hosted compiler's entry point (stage S1 of
// docs/PLAN-self-hosting.md).
//
//   kode-stage1 tokens <file.kode>
//   kode-stage1 ast <file.kode>
//
// The parser is S2 slice 1: assignments of a literal or a name, and call
// statements. Everything after it arrives with the later slices; until then an
// unsupported statement is a parse error, not a silent omission.

from "./ast" import ast_lines
from "./dump" import position, tokens_lines
from "./lexer" import lex
from "./parser" import parse
from "./report" import from_lex, render

argv = args()

if argv.len() == 0 {
    print("usage: kode-stage1 tokens <file.kode>")
    exit(2)
}

command = argv[0]

if command != "tokens" and command != "ast" {
    print("kode-stage1: `${command}` is not implemented yet; `tokens` and `ast` exist")
    exit(2)
}

if argv.len() < 2 {
    print("kode-stage1: `${command}` needs a file name")
    exit(2)
}

file = argv[1]
src = ""
try {
    src = read_file(file)
} catch e {
    print("kode-stage1: cannot read ${file}: ${e.message}")
    exit(1)
}

lx = lex(src)

if lx.errors.len() > 0 {
    // Diagnostics belong on stderr, and `kode tokens` puts them there. Each
    // report ends with a newline of its own, and `stderr` adds one, so the
    // stream gets a blank line between reports exactly like the oracle
    // (`stderr` is WP-10, ADR 0045).
    for err in lx.errors {
        stderr(render(file, src, from_lex(err)))
    }
    exit(1)
}

if command == "ast" {
    parsed = parse(src, lx)
    if parsed.errors.len() > 0 {
        for err in parsed.errors {
            stderr(render(file, src, err))
        }
        exit(1)
    }
    print(ast_lines(parsed.ast).join("\n"))
    exit(0)
}

// The dump ends with a newline, and `print` adds one, so the lines are joined
// without a trailing empty one.
print(tokens_lines(src, lx).join("\n"))
