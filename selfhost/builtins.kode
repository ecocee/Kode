// The names every program starts with: the builtin functions, the runtime's free
// functions, the modules that qualify them, and the prelude classes.
//
// `crates/kode-sema/src/std_fns.rs` is the source (AGENTS.md: one row per
// function), with the prelude and module names from `check/` and `modules.rs`. The
// port cannot read that table, so this one mirrors it. A `const` cannot hold a list
// (docs/PLAN-self-hosting.md), so the table is a field: one instance is built per
// checker, and `has` is what a name lookup asks.

pub class Builtins {
    names: [string] = [
        "print", "stderr", "len", "bytes", "StringBuilder", "int", "float", "string",
        "assert", "channel", "send", "recv", "close",
        "read_file", "write_file", "args", "env", "exit", "sleep", "now_ms", "now_ns",
        "chr", "exec", "json_parse", "json_null", "json_bool", "json_int", "json_float",
        "json_string", "json_list", "json_map", "json_encode", "math_sqrt", "math_abs",
        "math_floor", "math_ceil", "math_round", "math_sin", "math_cos", "math_tan",
        "math_log", "math_exp", "math_pow", "math_min", "math_max", "http_get",
        "http_post", "http_request", "pg_connect", "pg_exec", "pg_query", "pg_close",
        "pg_pool", "pg_pool_close", "pg_pool_connect", "pg_pool_release", "pg_pool_exec",
        "pg_pool_query", "json_obj", "response_json", "response_text", "response",
        "ProcessResult", "Request", "Response", "Router", "Error", "Json",
        "HttpResponse", "JsonKind",
        "fs", "http", "json", "math", "pg", "time"
    ]

    fn has(name: string) -> bool {
        return names.contains(name)
    }
}
