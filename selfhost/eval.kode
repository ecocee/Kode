// The interpreter over that MIR (S4): what a program prints.
//
// The evaluator keeps one `int` and one `string` per temporary and walks the
// instructions in order: an assignment or a `StrConcat` writes a temporary, an integer
// operator writes the result of its operands, and the print primitives append to a
// pending line — a separator appends a space, and `PrintNl` prints the line and clears
// it, the separator and newline rule `print` has. `release` is a no-op here: the
// interpreter has no reference counts to drop, and the gate still checks that the
// instruction is emitted. `goto` and `return` carry no work yet; the MIR is still one
// straight block, and control flow arrives with the branch that needs it.

from "./mir" import Block, Function, Instr, Mir, Operand, print_text

/// Run `mir` and write its output, exactly as the program would.
pub fn run(mir: Mir) {
    pending = ""
    for f in mir.functions {
        values: [int] = []
        refs: [string] = []
        for k in 0..f.temps.len() {
            values.add(0)
            refs.add("")
        }
        for b in f.blocks {
            for i in b.instrs {
                pending = print_step(pending, f, i, values, refs)
            }
        }
    }
}

fn print_step(pending: string, f: Function, i: Instr, values: [int], refs: [string]) -> string {
    if i.kind == "release" {
        return pending
    }
    if i.kind == "assign" {
        if f.temps[i.dest].kind == "ref" {
            refs[i.dest] = operand_str(i.args[0], refs)
        } else {
            values[i.dest] = operand_int(i.args[0], values)
        }
        return pending
    }
    if i.kind == "call" and i.dest >= 0 {
        // In this slice the only call with a destination is the concat.
        refs[i.dest] = operand_str(i.args[0], refs) + operand_str(i.args[1], refs)
        return pending
    }
    left = 0
    right = 0
    if i.kind == "add" or i.kind == "sub" or i.kind == "mul" or i.kind == "div" or i.kind == "rem" {
        left = operand_int(i.args[0], values)
        right = operand_int(i.args[1], values)
    }
    if i.kind == "add" {
        values[i.dest] = left + right
        return pending
    }
    if i.kind == "sub" {
        values[i.dest] = left - right
        return pending
    }
    if i.kind == "mul" {
        values[i.dest] = left * right
        return pending
    }
    if i.kind == "div" {
        values[i.dest] = left / right
        return pending
    }
    if i.kind == "rem" {
        values[i.dest] = left % right
        return pending
    }
    if i.kind != "call" {
        return pending
    }
    if i.callee == "rt::PrintNl" {
        print(pending)
        return ""
    }
    if i.callee == "rt::PrintSep" {
        return pending + " "
    }
    if i.args.len() == 0 {
        return pending
    }
    if i.callee == "rt::PrintInt" {
        return pending + "${operand_int(i.args[0], values)}"
    }
    if i.callee == "rt::PrintStr" {
        return pending + operand_str(i.args[0], refs)
    }
    return pending + print_text(i.args[0].value)
}

fn operand_int(o: Operand, values: [int]) -> int {
    if o.is_temp {
        return values[o.index]
    }
    return o.value.int_value
}

fn operand_str(o: Operand, refs: [string]) -> string {
    if o.is_temp {
        return refs[o.index]
    }
    return o.value.str_value
}
