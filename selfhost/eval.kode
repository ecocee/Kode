// The interpreter over that MIR (S4): what a program prints.
//
// The evaluator keeps one `int`, one `string` and one `bool` per temporary, plus the
// line being built, and it follows the blocks rather than walking them in order: a
// `goto` or a `branch` picks the next block, and a `return` ends the function. Within a
// block, an assignment or a `StrConcat` writes a temporary, an integer or comparison
// operator writes the result of its operands, and the print primitives append to the
// pending line — a separator appends a space, and `PrintNl` prints the line and clears
// it, the separator and newline rule `print` has. `retain` and `release` are no-ops
// here: the interpreter has no reference counts to drop, and the gate still checks that
// the instruction is emitted.

from "./mir" import Block, Function, Instr, Mir, Operand, print_text

/// What a running function holds: the pending line and one value per temporary.
class State {
    pending: string = ""
    values: [int] = []
    refs: [string] = []
    bools: [bool] = []
}

/// Run `mir` and write its output, exactly as the program would.
pub fn run(mir: Mir) {
    for f in mir.functions {
        // A declaration is not a program: only `main` runs.
        if not f.entry {
            continue
        }
        st = State()
        for k in 0..f.temps.len() {
            st.values.add(0)
            st.refs.add("")
            st.bools.add(false)
        }
        pc = 0
        while pc >= 0 {
            pc = run_block(f, pc, st)
        }
    }
}

/// Run one block, returning the block to run next, or -1 when the function is done.
fn run_block(f: Function, pc: int, st: State) -> int {
    for i in f.blocks[pc].instrs {
        if i.kind == "goto" {
            return label_index(f.blocks, i.target)
        }
        if i.kind == "branch" {
            if operand_bool(i.args[0], st) {
                return label_index(f.blocks, i.target)
            }
            return label_index(f.blocks, i.alt)
        }
        if i.kind == "return" {
            return -1
        }
        run_instr(f, i, st)
    }
    return -1
}

fn label_index(blocks: [Block], label: string) -> int {
    for k in 0..blocks.len() {
        if blocks[k].label == label {
            return k
        }
    }
    return -1
}

/// One instruction. `goto`, `branch` and `return` are the block loop's.
fn run_instr(f: Function, i: Instr, st: State) {
    if i.kind == "release" or i.kind == "retain" {
        return
    }
    if i.kind == "assign" {
        if f.temps[i.dest].kind == "ref" {
            st.refs[i.dest] = operand_str(i.args[0], st)
        } else if f.temps[i.dest].kind == "bool" {
            st.bools[i.dest] = operand_bool(i.args[0], st)
        } else {
            st.values[i.dest] = operand_int(i.args[0], st)
        }
        return
    }
    if i.kind == "call" and i.dest >= 0 {
        // A call with a destination returns a string: the concat, or an int rendered.
        if i.callee == "rt::IntToStr" {
            st.refs[i.dest] = "${operand_int(i.args[0], st)}"
        } else {
            st.refs[i.dest] = operand_str(i.args[0], st) + operand_str(i.args[1], st)
        }
        return
    }
    left = 0
    right = 0
    if i.kind == "add" or i.kind == "sub" or i.kind == "mul" or i.kind == "div" or i.kind == "rem" {
        left = operand_int(i.args[0], st)
        right = operand_int(i.args[1], st)
    }
    if i.kind == "add" {
        st.values[i.dest] = left + right
        return
    }
    if i.kind == "sub" {
        st.values[i.dest] = left - right
        return
    }
    if i.kind == "mul" {
        st.values[i.dest] = left * right
        return
    }
    if i.kind == "div" {
        st.values[i.dest] = left / right
        return
    }
    if i.kind == "rem" {
        st.values[i.dest] = left % right
        return
    }
    if i.kind == "lt" or i.kind == "le" or i.kind == "gt" or i.kind == "ge" or i.kind == "eq" or i.kind == "ne" {
        st.bools[i.dest] = compare(i.kind, operand_int(i.args[0], st), operand_int(i.args[1], st))
        return
    }
    if i.kind != "call" {
        return
    }
    if i.callee == "rt::PrintNl" {
        print(st.pending)
        st.pending = ""
        return
    }
    if i.callee == "rt::PrintSep" {
        st.pending += " "
        return
    }
    if i.args.len() == 0 {
        return
    }
    if i.callee == "rt::PrintInt" {
        st.pending += "${operand_int(i.args[0], st)}"
        return
    }
    if i.callee == "rt::PrintBool" {
        if operand_bool(i.args[0], st) {
            st.pending += "true"
        } else {
            st.pending += "false"
        }
        return
    }
    if i.callee == "rt::PrintStr" {
        st.pending += operand_str(i.args[0], st)
        return
    }
    st.pending += print_text(i.args[0].value)
}

fn compare(kind: string, left: int, right: int) -> bool {
    if kind == "lt" {
        return left < right
    }
    if kind == "le" {
        return left <= right
    }
    if kind == "gt" {
        return left > right
    }
    if kind == "ge" {
        return left >= right
    }
    if kind == "eq" {
        return left == right
    }
    return left != right
}

fn operand_int(o: Operand, st: State) -> int {
    if o.is_temp {
        return st.values[o.index]
    }
    return o.value.int_value
}

fn operand_str(o: Operand, st: State) -> string {
    if o.is_temp {
        return st.refs[o.index]
    }
    return o.value.str_value
}

fn operand_bool(o: Operand, st: State) -> bool {
    if o.is_temp {
        return st.bools[o.index]
    }
    return o.value.bool_value
}
