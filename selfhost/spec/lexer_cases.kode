// Lexer cases the language suite does not happen to cover, added because
// PLAN-self-hosting.md names Unicode and escapes as the S1 risk.
//
// `kode tokens` and `kode ast` read this file; nothing runs it.

tab = "a\tb"
quote = "she said \"hi\""
backslash = "c:\\temp"
nul = "before\0after"
money = "cost \$5"
emoji = "😀 done"
accents = "héllo wörld"
interpolation = "a${1 + 2}b"
nested_quotes = "outer ${string(len("héllo"))} inner"
brace_in_hole = "${"a } b"} tail"
escaped_dollar = "\${not a hole}"
numbers = [0, 42, 1_000, 3.14, 2.5e3, 1e-3, 0.5E+2]
ranges = [1..3, 1..=3]
comparisons = 1 < 2 and 3 <= 4 and 5 > 6
shifts = 8 >> 1 << 2
assignment = 0
assignment += 1
assignment -= 1
assignment *= 2
assignment /= 2
assignment %= 2
bits = 1 & 2 | 3 ^ 4
tilde = ~0
arrow = 1
fn shifted(n: int) -> int => n >> 1
fn fat(n: int) -> int => n
comment = 1 // a line comment with ${braces} and "quotes"
block = 2 /* a block comment with * and / and "quotes" */ + 3
