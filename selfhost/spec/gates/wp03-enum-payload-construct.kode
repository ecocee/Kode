// work packet: WP03 enum payload construction
// target: ok
// A variant with fields is a value, printed the way it is written (ADR 0039).
enum Shape {
    Circle(radius: float)
    Rect(width: float, height: float)
    Empty
}

print(Shape.Circle(radius: 1.5))
print(Shape.Rect(width: 2.0, height: 3.0))
print(Shape.Empty)
