    work()
} catch e {
    log(e)
} finally {
    clean()
}
try {
    try {
        inner()
    } catch first {
        print(first)
    }
    outer()
} catch second {
    throw second
}
fn risky(n: int) -> int {
    try {
        if n < 0 {
            throw "negative"
        }
        return n
    } catch err {
        return 0
    }
}
