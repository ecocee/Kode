// The nesting limit of the self-hosted compiler (ADR 0032): 128 levels.
//
// Two things enforce it, exactly as the oracle does. The parser guards its own
// recursion (`guard`, called on entry to the expression, block and type
// productions), which catches `((((1))))` and a tower of `if`s. The finished tree
// is then walked with an explicit stack (`too_deep`), which catches what a loop
// built: `1 + 1 + ...` is left-deep and costs the later passes one frame per term
// even though the parser never recursed. Both report `E0118`; neither is reported
// once the parse has already failed, because the oracle only walks a clean tree.
//
// The walk mirrors `crates/kode-syntax/src/depth.rs` node for node, including its
// stack order (the last child pushed is visited first) and the levels a wrapper
// does not add: an item's children start at depth 1, and `Then`, `Else`, `Arg`,
// `Param`, `Handler`, `Entry`, `Hole` and the like are transparent — their
// contents sit at the depth the wrapper was given.

from "./ast" import Ast, is_type_node
from "./cursor" import Cursor

pub const MAX_NESTING = 128

const DEEP_HELP = "split it up: bind part of it to a variable on its own line, or use a loop"

/// One node waiting to be visited, with the depth it sits at.
pub class Spot {
    id: int
    depth: int
}

/// True when the parse cannot go one level deeper. The first depth error is also
/// the last report: from there the tree is unreliable, so the cursor moves to the
/// end of the file and everything above unwinds without another diagnostic.
pub fn guard(c: Cursor) -> bool {
    if c.fatal {
        return true
    }
    if c.depth < MAX_NESTING {
        return false
    }
    c.fail("E0118", message(), c.token_start(c.at), c.token_end(c.at), DEEP_HELP)
    c.fatal = true
    c.at = c.tokens.len()
    return true
}

fn message() -> string {
    return "this nests deeper than ${MAX_NESTING} levels"
}

/// The first node deeper than `MAX_NESTING`, as `[start, end]`, or `[]`.
pub fn too_deep(ast: Ast) -> [int] {
    spots: [Spot] = []
    if ast.nodes.len() == 0 {
        return []
    }
    for item in ast.nodes[0].kids {
        push_item(ast, spots, item)
    }
    while spots.len() > 0 {
        spot = spots.pop()
        if spot.depth > MAX_NESTING {
            return node_span(ast, spot.id)
        }
        push_children(ast, spots, spot.id, spot.depth + 1)
    }
    return []
}

fn push_spot(spots: [Spot], id: int, depth: int) {
    spots.add(Spot(id: id, depth: depth))
}

// ---- items: their children start at depth 1, as the oracle pushes them ----

fn push_item(ast: Ast, spots: [Spot], id: int) {
    kind = ast.nodes[id].kind
    if kind == "Fn" or kind == "Method" {
        push_fn(ast, spots, id)
        return
    }
    if kind == "Class" {
        for kid in ast.nodes[id].kids {
            member = ast.nodes[kid].kind
            if member == "Field" {
                push_field(ast, spots, kid)
            } else if member == "Method" {
                push_fn(ast, spots, kid)
            }
        }
        return
    }
    if kind == "Interface" {
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "IfaceMethod" {
                push_signature(ast, spots, kid)
            }
        }
        return
    }
    if kind == "Enum" {
        for variant in ast.nodes[id].kids {
            push_params(ast, spots, variant)
        }
        return
    }
    if kind == "Const" {
        for kid in ast.nodes[id].kids {
            push_spot(spots, kid, 1)
        }
        return
    }
    if kind == "Import" {
        return
    }
    push_spot(spots, id, 1)
}

/// A function or method body: parameter and return annotations, then the body.
fn push_fn(ast: Ast, spots: [Spot], id: int) {
    for kid in ast.nodes[id].kids {
        kind = ast.nodes[kid].kind
        if kind == "Param" {
            push_params(ast, spots, kid)
        } else if kind == "Block" {
            push_spot(spots, kid, 1)
        } else if kind == "ExprBody" {
            for body in ast.nodes[kid].kids {
                push_spot(spots, body, 1)
            }
        } else if is_type_node(kind) {
            push_spot(spots, kid, 1)
        }
    }
}

/// A field's annotation and its default value.
fn push_field(ast: Ast, spots: [Spot], id: int) {
    for kid in ast.nodes[id].kids {
        if ast.nodes[kid].kind == "Default" {
            for value in ast.nodes[kid].kids {
                push_spot(spots, value, 1)
            }
        } else {
            push_spot(spots, kid, 1)
        }
    }
}

/// An interface signature: annotations only, because there is no body.
fn push_signature(ast: Ast, spots: [Spot], id: int) {
    for kid in ast.nodes[id].kids {
        if ast.nodes[kid].kind == "Param" {
            push_params(ast, spots, kid)
        } else if is_type_node(ast.nodes[kid].kind) {
            push_spot(spots, kid, 1)
        }
    }
}

/// The annotations of a `Param` (a function parameter, an enum payload field or a
/// signature parameter). A parameter has no level of its own.
fn push_params(ast: Ast, spots: [Spot], id: int) {
    for kid in ast.nodes[id].kids {
        if is_type_node(ast.nodes[kid].kind) {
            push_spot(spots, kid, 1)
        }
    }
}

// ---- children of one visited node ----

fn push_children(ast: Ast, spots: [Spot], id: int, next: int) {
    kind = ast.nodes[id].kind
    kids = ast.nodes[id].kids
    if kind == "TypeGeneric" {
        // The oracle's walk pushes generic arguments at depth 1 whatever encloses
        // them. Kept as it is: the goal here is the same report, not a better one.
        for kid in kids {
            push_spot(spots, kid, 1)
        }
        return
    }
    if kind == "Closure" {
        // The oracle walks the body only; a closure parameter's annotation is not
        // part of the limit.
        for kid in kids {
            if ast.nodes[kid].kind != "ClosureParam" {
                push_spot(spots, kid, next)
            }
        }
        return
    }
    if kind == "If" {
        for kid in kids {
            tag = ast.nodes[kid].kind
            if tag == "Then" or tag == "Else" {
                for inner in ast.nodes[kid].kids {
                    push_spot(spots, inner, next)
                }
            } else {
                push_spot(spots, kid, next)
            }
        }
        return
    }
    if kind == "ForIn" {
        for kid in kids {
            tag = ast.nodes[kid].kind
            if tag == "Iter" {
                for inner in ast.nodes[kid].kids {
                    push_spot(spots, inner, next)
                }
            } else if tag != "Var" {
                push_spot(spots, kid, next)
            }
        }
        return
    }
    if kind == "Match" or kind == "Try" {
        for kid in kids {
            tag = ast.nodes[kid].kind
            if tag == "Scrutinee" or tag == "Handler" or tag == "Finally" {
                for inner in ast.nodes[kid].kids {
                    push_spot(spots, inner, next)
                }
            } else if tag != "CatchVar" {
                push_spot(spots, kid, next)
            }
        }
        return
    }
    if kind == "Map" or kind == "Slice" {
        for kid in kids {
            tag = ast.nodes[kid].kind
            if tag == "Entry" or tag == "Start" or tag == "End" {
                for inner in ast.nodes[kid].kids {
                    push_spot(spots, inner, next)
                }
            } else {
                push_spot(spots, kid, next)
            }
        }
        return
    }
    if kind == "Call" or kind == "Spawn" or kind == "MethodCall" {
        for kid in kids {
            if ast.nodes[kid].kind == "Arg" {
                for inner in ast.nodes[kid].kids {
                    push_spot(spots, inner, next)
                }
            } else {
                push_spot(spots, kid, next)
            }
        }
        return
    }
    if kind == "Interp" {
        for kid in kids {
            if ast.nodes[kid].kind == "Hole" {
                for inner in ast.nodes[kid].kids {
                    push_spot(spots, inner, next)
                }
            }
        }
        return
    }
    for kid in kids {
        push_spot(spots, kid, next)
    }
}

// ---- the span the oracle reports for each measured node ----

/// A node's span for the diagnostic. Most carry `span`; the oracle's helpers give
/// a statement its condition, a `Try` its first statement, an `Arm` its pattern
/// and a target the expression it came from.
fn node_span(ast: Ast, id: int) -> [int] {
    kind = ast.nodes[id].kind
    if kind == "ExprStmt" or kind == "PatternValue" or kind == "TargetIndex" {
        return first_span(ast, id)
    }
    if kind == "If" or kind == "While" or kind == "For" or kind == "Try" {
        return first_span(ast, id)
    }
    if kind == "ForIn" {
        for kid in ast.nodes[id].kids {
            if ast.nodes[kid].kind == "Iter" {
                return first_span(ast, kid)
            }
        }
        return [0, 0]
    }
    if kind == "Wildcard" {
        return [0, 0]
    }
    if kind == "TargetField" {
        return ast.attr_span_named(id, "name_span")
    }
    if kind == "Arm" {
        return ast.attr_span_named(id, "pattern_span")
    }
    span = ast.attr_span(id)
    if span.len() == 2 {
        return span
    }
    return [0, 0]
}

/// The span of the first child that has one; a `Block` has none of its own.
fn first_span(ast: Ast, id: int) -> [int] {
    for kid in ast.nodes[id].kids {
        span = ast.attr_span(kid)
        if span.len() == 2 {
            return span
        }
        return first_span(ast, kid)
    }
    return [0, 0]
}
