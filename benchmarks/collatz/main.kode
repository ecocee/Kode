best = 0
best_steps = 0
for n in 1..1500000 {
    x = n
    steps = 0
    while x != 1 {
        if x % 2 == 0 {
            x = x / 2
        } else {
            x = 3 * x + 1
        }
        steps += 1
    }
    if steps > best_steps {
        best_steps = steps
        best = n
    }
}
print(best)
