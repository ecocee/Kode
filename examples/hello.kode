# Strings
name = "Hello, KODE"
message = "Welcome to my programming language"

# Integers
age = 23
count = 100
price = 500

# Floating point
height = 170.5
rating = 4.8

# Boolean
active = true

# Print variables
print(name)
print(message)

print(age)
print(count)
print(price)

print(height)
print(rating)

print(active)

# Arithmetic
total = 100 + 200
difference = 500 - 100
product = 20 * 5
average = total / 2

print(total)
print(difference)
print(product)
print(average)

# String concatenation
greeting = "Hello " + name
print(greeting)

# Expressions
print(10 + 20 * 3)
print((100 + 50) / 2)

# Comparisons
print(age > 18)
print(price == 500)
print(height < 180.0)