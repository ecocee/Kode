// Test connection pooling functionality
// Run with: KODE_TEST_PG_URL='postgres://bench:bench@127.0.0.1:55432/kode_bench?sslmode=disable' ./target/debug/kode run tests/pg_pool_test.kode

url = env("KODE_TEST_PG_URL") ?? "postgres://bench:bench@127.0.0.1:55432/kode_bench?sslmode=disable"

// Create a connection pool with min 1, max 3 connections
pool = pg.pool(url, 1, 3, 5000)
print("pool created:", pool)

// Use pool_connect to get a connection
conn = pg.pool_connect(pool)
print("got connection:", conn)

// Execute a query on the borrowed connection
pg.exec(conn, "CREATE TABLE IF NOT EXISTS pool_test (id int primary key, name text)")
print("table created")

// Insert some data using pool_query (auto connect/release)
pg.pool_query(pool, "INSERT INTO pool_test (id, name) VALUES ($1, $2)", [json.int(1), json.string("pool_test")])
print("inserted via pool_query")

// Release the connection back to the pool
pg.pool_release(conn)
print("released connection")

// Now use pool_query which handles connect/release automatically
result = pg.pool_query(pool, "SELECT * FROM pool_test ORDER BY id", [])
print("pool_query result:")
print("  command:", result["command"].as_string())
print("  rows:", result["rows"].as_list().len())
for row in result["rows"].as_list() {
    print("  ", row["id"].as_int(), row["name"].as_string())
}

// Test pool_exec with a simple statement (no params)
exec_result = pg.pool_exec(pool, "UPDATE pool_test SET name = 'updated' WHERE id = 1")
print("pool_exec affected:", exec_result["affected"].as_int())

// Verify the update
verify = pg.pool_query(pool, "SELECT name FROM pool_test WHERE id = $1", [json.int(1)])
print("after update:", verify["rows"].as_list()[0]["name"].as_string())

// Close the pool
pg.pool_close(pool)
print("pool closed")

print("pool test passed")
