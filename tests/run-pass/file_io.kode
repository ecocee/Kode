// The temp directory differs per system: `TEMP` on Windows, `TMPDIR` on some
// Unix systems, and `/tmp` as the fallback both accept.
tmp = env("TEMP") ?? env("TMPDIR") ?? "/tmp"
file = tmp + "/kode_io_test.txt"
write_file(file, "line1\nline2\n")
text = read_file(file)
lines = text.trim().split("\n")
print(len(lines), lines[1])
missing = read_file(tmp + "/definitely/not/here.txt") catch e {
    print("read failed")
    ""
}
print(missing.size())
t0 = now_ms()
sleep(20)
print(now_ms() - t0 >= 15)
print(env("KODE_SURELY_NOT_SET") ?? "unset")
print(len(args()))
